     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc227140704" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">2.</text:span><text:span text:style-name="T19"> </text:span><text:span text:style-name="T3">Windows Installation</text:span><text:span text:style-name="T26"> 4</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140705" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.1.<text:span text:style-name="T20"> </text:span>Installation de Scripture App Builder <text:span text:style-name="T26">5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140706" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.2.<text:span text:style-name="T20"> </text:span>Installation du kit de développement Java (JDK) <text:span text:style-name="T26">5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140707" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">2.2.1.</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T3">Installing the JDK using the Install JDK wizard</text:span><text:span text:style-name="T26"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140708" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">2.2.2.</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T3">Installing the JDK from the Azul website</text:span><text:span text:style-name="T26"> 5</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140709" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.3.<text:span text:style-name="T20"> </text:span>Installing the Android Software Development Kit (SDK)<text:span text:style-name="T26"> 7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140710" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/><text:span text:style-name="T3">2.3.1.</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T3">Downloading the Android SDK packages from the internet</text:span><text:span text:style-name="T26"> 7</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140711" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">2.3.2.</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T3">Copying the Android SDK files from someone else</text:span><text:span text:style-name="T26"> 8</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140712" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">2.4.<text:span text:style-name="T20"> </text:span>Installing aeneas for audio-text synchronization<text:span text:style-name="T26"> 9</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc227140713" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.</text:span><text:span text:style-name="T19"> </text:span><text:span text:style-name="T3">Linux Installation</text:span><text:span text:style-name="T26"> 12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140714" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.1.<text:span text:style-name="T20"> </text:span>Flathub<text:span text:style-name="T26"> 12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_2" loext:marker-style-name="T16"><text:a xlink:type="simple" xlink:href="#_Toc227140715" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.<text:span text:style-name="T20"> </text:span>SIL repository for Ubuntu<text:span text:style-name="T26"> 12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140716" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.1.<text:span text:style-name="T25"> </text:span>Add SIL repository for Ubuntu<text:span text:style-name="T26"> 12</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140717" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.2.<text:span text:style-name="T25"> </text:span>Installing all packages from the Internet<text:span text:style-name="T26"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140718" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.3.<text:span text:style-name="T25"> </text:span>Downloading the Android SDK files prior to package installation<text:span text:style-name="T26"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140719" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:soft-page-break/><text:span text:style-name="T3">3.2.4.</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T3">Downloading the Android SDK files</text:span><text:span text:style-name="T26"> 13</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140720" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">3.2.5.</text:span><text:span text:style-name="T25"> </text:span><text:span text:style-name="T3">Provide zip files during the package install</text:span><text:span text:style-name="T26"> 14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140721" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.6.<text:span text:style-name="T25"> </text:span>Installing without Android SDK<text:span text:style-name="T26"> 14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_3" loext:marker-style-name="T17"><text:a xlink:type="simple" xlink:href="#_Toc227140722" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">3.2.7.<text:span text:style-name="T25"> </text:span>Automating Android SDK installation<text:span text:style-name="T26"> 14</text:span></text:a></text:p>
     <text:p text:style-name="Contents_20_1" loext:marker-style-name="T15"><text:a xlink:type="simple" xlink:href="#_Toc227140723" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link"><text:span text:style-name="T3">4.</text:span><text:span text:style-name="T19"> </text:span><text:span text:style-name="T3">How to build your first app</text:span><text:span text:style-name="T26"> 15</text:span></text:a></text:p>
    </text:index-body>
   </text:table-of-content>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:h text:style-name="P6" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc227140703"/><text:span text:style-name="T3">Introduction</text:span><text:bookmark-end text:name="_Toc227140703"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Scripture App Builder fait ce que son nom suggère : il vous aide à créer des applications bibliques personnalisées pour les smartphones et les tablettes.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Vous spécifiez les fichiers bibliques à utiliser, le nom de l&apos;application, les polices, les couleurs, les informations de la boîte à propos, l&apos;audio et les icônes. Scripture App Builder regroupera tout et créera l&apos;application personnalisée pour vous. Vous l&apos;installez ensuite sur votre appareil mobile, l&apos;envoyez à d&apos;autres personnes par le biais d&apos;une application de transfert Bluetooth ou Wi-Fi, le partagez sur des cartes mémoire microSD et le publiez sur des magasins d&apos;applications sur Internet.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><draw:frame draw:style-name="fr2" draw:name="Image2" text:anchor-type="as-char" svg:width="5.9098in" svg:height="2.9654in" draw:z-index="0"><draw:image xlink:href="SAB01/3.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour installer Scripture App Builder sous </text:span><text:span text:style-name="T5">Windows</text:span><text:span text:style-name="T3">, veuillez suivre les instructions de la section 2. Pour </text:span><text:span text:style-name="T5">Linux</text:span><text:span text:style-name="T3">, veuillez trouver les instructions dans la section 3. </text:span></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Pour </text:span><text:span text:style-name="T5">Mac</text:span><text:span text:style-name="T3">, vous pouvez trouver les instructions d&apos;installation dans le document </text:span><text:span text:style-name="T5">Installation et création d&apos;applications sur un Mac</text:span><text:span text:style-name="T3">.</text:span></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:h text:style-name="Heading_20_1" text:outline-level="1" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc227140704"/><text:span text:style-name="T3">Windows Installation</text:span><text:bookmark-end text:name="_Toc227140704"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour exécuter Scripture App Builder sur Windows, vous devez avoir 3 composants installés sur votre ordinateur :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum1">
    <text:list-item>
     <text:p text:style-name="P50" loext:marker-style-name="T3"><text:span text:style-name="T3">Scripture App Builder</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P49" loext:marker-style-name="T3"><text:span text:style-name="T3">Kit de développement Java (JDK)</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P49" loext:marker-style-name="T3"><text:span text:style-name="T3">Kit de développement logiciel (SDK) Android</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Il existe un quatrième composant facultatif à installer si vous souhaitez synchroniser le texte et l&apos;audio :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:continue-numbering="true" text:style-name="WWNum1">
    <text:list-item>
     <text:p text:style-name="P51" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Outil de synchronisation audio-texte Aeneas.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:span text:style-name="T3">Voici plus de détails sur l&apos;installation de chacun de ces composants.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:h text:style-name="P8" text:outline-level="2"><text:bookmark-start text:name="_Toc227140705"/>Installation de Scripture App Builder<text:bookmark-end text:name="_Toc227140705"/></text:h>
   <text:p text:style-name="P52" loext:marker-style-name="T3"><text:span text:style-name="T3">Pour installer le programme Scripture App Builder, procédez comme suit :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum7">
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">Accédez à la </text:span><text:span text:style-name="T5">page de téléchargement</text:span><text:span text:style-name="T3"> du site Web de l&apos;App Builder : </text:span><text:a xlink:type="simple" xlink:href="http://software.sil.org/scriptureappbuilder/download/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T3">http://software.sil.org/scriptureappbuilder/download</text:span></text:span></text:a><text:span text:style-name="T3"> </text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">Téléchargez le dernier programme d&apos;installation pour Windows.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P9" loext:marker-style-name="T3"><text:span text:style-name="T3">Exécutez le programme d&apos;installation, </text:span><text:span text:style-name="T5">Scripture-App-Builder-x.x-Setup.exe</text:span><text:span text:style-name="T3">, pour installer Scripture App Builder sur votre ordinateur.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3"><text:line-break/> </text:span><text:span text:style-name="T3"/></text:p>
   <text:h text:style-name="P8" text:outline-level="2"><text:bookmark-start text:name="_Toc227140706"/>Installation du kit de développement Java (JDK)<text:bookmark-end text:name="_Toc227140706"/></text:h>
   <text:p text:style-name="P53" loext:marker-style-name="T3"><text:bookmark-start text:name="_Hlk534311866"/><text:span text:style-name="T3">Vous aurez besoin de la version 17 du kit de développement Java (JDK) pour créer des applications. Il y a deux façons de l&apos;installer :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum14">
    <text:list-item>
     <text:p text:style-name="P10" loext:marker-style-name="T3"><text:span text:style-name="T3">Utilisez l&apos;assistant d&apos;installation de JDK dans Scripture App Builder (voir section 2.2.1), ou</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P11" loext:marker-style-name="T3"><text:span text:style-name="T3">Téléchargez le fichier d&apos;installation du JDK à partir du site Web d&apos;Azul et lancez l&apos;installateur (voir la section 2.2.2).</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P12" loext:marker-style-name="T3"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc227140707"/><text:span text:style-name="T3">Installation du JDK à l&apos;aide de l&apos;assistant d&apos;installation du JDK</text:span><text:bookmark-end text:name="_Toc227140707"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="P53" loext:marker-style-name="T3"><text:span text:style-name="T3">La façon la plus simple d&apos;installer le kit de développement Java (JDK) est d&apos;utiliser l&apos;assistant d&apos;installation de JDK dans Scripture App Builder :</text:span><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum13">
    <text:list-item>
     <text:p text:style-name="P14" loext:marker-style-name="T3"><text:span text:style-name="T3">Lancez </text:span><text:span text:style-name="T6">Scripture App Builder</text:span><text:span text:style-name="T3">.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P14" loext:marker-style-name="T3"><text:soft-page-break/><text:span text:style-name="T3">Cliquez sur le </text:span><text:span text:style-name="T6">bouton « Installer JDK » </text:span><text:span text:style-name="T3">sur la page d&apos;accueil (ou sélectionnez </text:span><text:span text:style-name="T6">Outils</text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T27"></text:span><text:span text:style-name="T3"> </text:span><text:span text:style-name="T6">Installer JDK</text:span><text:span text:style-name="T3"> dans le menu principal).</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P14" loext:marker-style-name="T3"><text:span text:style-name="T3">Suivez les instructions de l&apos;Assistant pour télécharger et installer le JDK.</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P54" loext:marker-style-name="T3"><text:span text:style-name="T3">Si le JDK a été installé avec succès, ignorez la section 2.2.2 et passez à la section 2.3 pour installer le SDK Android.</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P41" loext:marker-style-name="T3"/>
   <text:h text:style-name="Heading_20_3" text:outline-level="3" loext:marker-style-name="T3"><text:bookmark-start text:name="_Toc227140708"/><text:span text:style-name="T3">Installation du JDK à partir du site Web d&apos;Azul</text:span><text:bookmark-end text:name="_Toc227140708"/><text:span text:style-name="T3"/></text:h>
   <text:p text:style-name="P53" loext:marker-style-name="T3"><text:span text:style-name="T3">Nous vous recommandons d&apos;utiliser Zulu, qui est une distribution gratuite d&apos;OpenJDK d&apos;Azul.</text:span><text:bookmark-end text:name="_Hlk534311866"/><text:span text:style-name="T3"/></text:p>
   <text:list text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P16" loext:marker-style-name="T3"><text:span text:style-name="T3">Allez sur le site Web de </text:span><text:span text:style-name="T6">Téléchargement des versions Zulu d&apos;OpenJDK</text:span><text:span text:style-name="T3"> :</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P55" loext:marker-style-name="T28"/>
   <text:p text:style-name="P56" loext:marker-style-name="T14"><text:a xlink:type="simple" xlink:href="https://www.azul.com/downloads/?version=java-17-lts&amp;os=windows&amp;architecture=x86-64-bit&amp;package=jdk#zulu" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T14">https://www.azul.com/downloads/?version=java-17-lts&amp;os=windows&amp;architecture=x86-64-bit&amp;package=jdk#zulu</text:span></text:span></text:a><text:span text:style-name="T14"/></text:p>
   <text:p text:style-name="P42" loext:marker-style-name="T3"><text:soft-page-break/></text:p>
   <text:p text:style-name="P56" loext:marker-style-name="T3"><text:span text:style-name="T3">Il y a beaucoup de téléchargements sur cette page, mais le lien ci-dessus filtrera ceux que vous voyez (Version Java : Java 17 LTS ; Système d&apos;exploitation : Windows ; Architecture : x86 64 bits ; Package Java : JDK).</text:span><text:span text:style-name="T3"/></text:p>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum10">
    <text:list-item>
     <text:p text:style-name="P15" loext:marker-style-name="T3"><text:span text:style-name="T3">Faites défiler la page jusqu&apos;à ce que vous voyiez les téléchargements :</text:span><text:span text:style-name="T3"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P39" loext:marker-style-name="T3"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T3"><draw:custom-shape text:anchor-type="char" draw:z-index="37" draw:name="AutoShape 7" draw:style-name="gr1" draw:text-style-name="P80" svg:width="0.5079in" svg:height="0.2323in" draw:transform="rotate (-0.867952237016781) translate (5.58680555555556in 2.33055555555556in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f14 ?f13 ?f7" draw:text-areas="?f12 ?f8 ?f13 ?f9" draw:type="ooxml-leftArrow" draw:modifiers="50000 75000" draw:enhanced-path="M 0 ?f7 L ?f5 0 ?f5 ?f8 ?f13 ?f8 ?f13 ?f9 ?f5 ?f9 ?f5 ?f14 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="0+?f4 -0"/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
