   <text:p text:style-name="P3" loext:marker-style-name="T88"><text:span text:style-name="T88">Exemple d&apos;images du panneau de navigation</text:span><text:span text:style-name="T88"/></text:p>
   <text:p text:style-name="P373" loext:marker-style-name="T88"/>
   <text:p text:style-name="P305" loext:marker-style-name="T52"><draw:frame draw:style-name="fr2" draw:name="Frame8" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="29" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table41" table:style-name="Table41">
       <table:table-column table:style-name="Table41.A" table:number-columns-repeated="2"/>
       <table:table-row table:style-name="Table41.1">
        <table:table-cell table:style-name="Table41.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Pour modifier cette…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table41.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Ajuster le style de l&apos;interface…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table41.1">
        <table:table-cell table:style-name="Table41.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Arrière-plan du panneau de navigation</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table41.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">tiroir ui.ui</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table41.1">
        <table:table-cell table:style-name="Table41.A3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Texte du tiroir de navigation</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table41.B3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Texte de l\&apos;article</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table41.1">
        <table:table-cell table:style-name="Table41.A4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Icône de l&apos;élément du panneau de navigation</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table41.B4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Icône</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
