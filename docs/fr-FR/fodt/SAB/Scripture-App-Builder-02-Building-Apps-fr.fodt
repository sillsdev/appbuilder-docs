        </table:table-cell>
        <table:table-cell table:style-name="Table125.B4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">.study-bible-heading:hover</text:span></text:p>
        </table:table-cell>
       </table:table-row>
