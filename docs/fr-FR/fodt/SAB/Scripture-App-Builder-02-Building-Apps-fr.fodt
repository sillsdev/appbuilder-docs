    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P85" loext:marker-style-name="T39"/>
   <text:p text:style-name="P103" loext:marker-style-name="T39"><text:span text:style-name="T39">Lorsque vous faites cela, vous recevrez probablement un message « Autoriser le débogage USB ? » Appuyez sur </text:span><text:span text:style-name="T53">OK</text:span><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P100" loext:marker-style-name="T39"><draw:custom-shape text:anchor-type="char" draw:z-index="14" draw:name="AutoShape 160" draw:style-name="gr11" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (-2.68571265296887) translate (4.61180555555556in 2.15902777777778in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
