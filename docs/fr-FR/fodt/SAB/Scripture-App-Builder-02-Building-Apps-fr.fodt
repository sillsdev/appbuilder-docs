     <text:p text:style-name="P37" loext:marker-style-name="T118"><text:a xlink:type="simple" xlink:href="#_Toc233871404" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">23.32.<text:span text:style-name="T123"> </text:span>Styles des comptes utilisateurs<text:span text:style-name="T134"> 209</text:span></text:a></text:p>
