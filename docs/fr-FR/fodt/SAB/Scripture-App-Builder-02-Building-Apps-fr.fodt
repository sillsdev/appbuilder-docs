     </table:table-cell>
     <table:table-cell table:style-name="Table20.A1" office:value-type="string">
      <text:p text:style-name="P4" loext:marker-style-name="T52"><text:span text:style-name="T52">Description</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A2" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-new</text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B2" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Créer un nouveau projet d&apos;application</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A3" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-Charge &lt;project&gt;</text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B3" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Charger un projet d&apos;application existant</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A4" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-build</text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B4" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Construire un projet d&apos;application (utiliser avec -new ou -load)</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A5" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-no-save </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B5" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Ne pas enregistrer les modifications apportées à l&apos;application (utiliser avec -load)</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A6" office:value-type="string">
      <text:p text:style-name="P352" loext:marker-style-name="T172"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B6" office:value-type="string">
      <text:p text:style-name="P355" loext:marker-style-name="T151"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A7" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-?</text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B7" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Afficher l&apos;aide en ligne de commande</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A8" office:value-type="string">
      <text:p text:style-name="P352" loext:marker-style-name="T172"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B8" office:value-type="string">
      <text:p text:style-name="P355" loext:marker-style-name="T151"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A9" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-n &lt;app-name&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B9" office:value-type="string">
      <text:p text:style-name="P298" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir le nom de l&apos;application.<text:line-break/>Fermer le nom en &quot;guillemets doubles&quot; s&apos;il contient des espaces.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A10" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-p &lt;package-name&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B10" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir le nom du paquet, par exemple com.myorg.language.appname</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A11" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-b &lt;filename&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B11" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Ajouter un livre ou un paquet de fichiers. Il peut s&apos;agir d&apos;un fichier USFM ou d&apos;un ensemble compressé de fichiers USFM. Il pourrait également s&apos;agir d&apos;un ensemble de textes de la bibliothèque biblique numérique.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A12" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-i &lt;filename&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B12" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Inclure le fichier de paramètres supplémentaires.<text:line-break/>Utiliser le chemin complet du fichier et l&apos;entourer de &quot;guillemets doubles&quot; s&apos;il y a un espace dans le chemin.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A13" office:value-type="string">
      <text:p text:style-name="P352" loext:marker-style-name="T172"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B13" office:value-type="string">
      <text:p text:style-name="P355" loext:marker-style-name="T151"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A14" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-a &lt;filename&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B14" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir à propos de la boîte de texte, contenu dans le fichier texte.<text:line-break/>Utiliser le chemin complet du fichier et l&apos;entourer de &quot;guillemets doubles&quot; s&apos;il y a un espace dans le chemin.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A15" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-f &lt;fontname&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B15" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définissez le nom de la police ou le nom du fichier, par exemple &quot;Charis SIL Compact&quot;, &quot;c:\fonts\myfont. tf&quot;<text:line-break/>Le nom de police doit être l&apos;un des éléments de la liste des polices dans l&apos;assistant de la nouvelle application. Pour les autres polices, spécifiez le chemin complet vers le nom du fichier de police.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A16" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-ic &lt;filename&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B16" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Ajouter l&apos;icône du lanceur (un ou plusieurs fichiers .png).<text:line-break/>Utilisez le chemin complet des fichiers et enfermez-les dans des &quot;guillemets doubles&quot; s&apos;il y a un espace dans le chemin.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A17" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-l &lt;lang-code&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B17" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Set language for menu items and settings, e.g. en, fr, es</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A18" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-ft &lt;feature=value&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B18" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir une fonctionnalité, par exemple livre-select=grille</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A19" office:value-type="string">
      <text:p text:style-name="P352" loext:marker-style-name="T172"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B19" office:value-type="string">
      <text:p text:style-name="P355" loext:marker-style-name="T151"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A20" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-vc &lt;integer&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B20" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définit le code de version, par exemple 1, 2, 3, ou +1 pour incrémenter le code de version actuel par 1.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A21" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-vn &lt;string&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B21" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définissez le nom de la version, par exemple 1.0, 2.1.4, ou utilisez +1, +0.1, +0.0.1 pour incrémenter la valeur actuelle.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A22" office:value-type="string">
      <text:p text:style-name="P352" loext:marker-style-name="T172"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B22" office:value-type="string">
      <text:p text:style-name="P355" loext:marker-style-name="T151"/>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A23" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-ks &lt;filename&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B23" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir le nom du fichier du porte-clés.<text:line-break/>Utiliser le chemin complet du fichier et l&apos;entourer de &quot;guillemets doubles&quot; s&apos;il y a un espace dans le chemin.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A24" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-ksp &lt;password&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B24" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir le mot de passe du clavier</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A25" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-ka &lt;alias&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B25" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir l&apos;alias de clé</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A26" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-kap &lt;password&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B26" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définir le mot de passe d&apos;alias de clé</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table20.27">
     <table:table-cell table:style-name="Table20.A27" office:value-type="string">
      <text:p text:style-name="P352" loext:marker-style-name="T172"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B27" office:value-type="string">
      <text:p text:style-name="P355" loext:marker-style-name="T151"/>
     </table:table-cell>
    </table:table-row>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table20.1">
     <table:table-cell table:style-name="Table20.A28" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">-fp &lt;folder=path&gt; </text:span><text:span text:style-name="T172"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table20.B28" office:value-type="string">
      <text:p text:style-name="P15" loext:marker-style-name="T151"><text:span text:style-name="T151">Définissez un chemin de dossier, par exemple &quot;app.builder=c:\Scripture App Builder&quot;.</text:span><text:span text:style-name="T151"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P360" loext:marker-style-name="T183"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Exemples :</text:span><text:span text:style-name="T52"/></text:p>
   <text:p text:style-name="P15" loext:marker-style-name="T172"><text:span text:style-name="T172">sab -new -n \&quot;My App\&quot; -p com.example.myapp -b MyBookBundle.zip <text:line-break/> -f \&quot;Charis SIL Compact\&quot; -i keys.txt –build</text:span><text:span text:style-name="T172"/></text:p>
   <text:p text:style-name="P352" loext:marker-style-name="T172"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T172"><text:span text:style-name="T172">sab -load \&quot;My App\&quot; -build</text:span><text:span text:style-name="T172"/></text:p>
   <text:p text:style-name="P353" loext:marker-style-name="T172"/>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_How_can_I_2"/><text:bookmark-start text:name="_Toc233871063"/><text:span text:style-name="T39">Comment puis-je ajouter une ligne horizontale pour séparer certains paragraphes dans le texte?</text:span><text:bookmark-end text:name="_Toc233871063"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Utilisez le marqueur </text:span><text:span text:style-name="T52">\zhr</text:span><text:span text:style-name="T39"> pour ajouter une ligne horizontale. Cela va ajouter un élément </text:span><text:span text:style-name="T52">&lt;hr&gt;</text:span><text:span text:style-name="T39"> dans le code HTML.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Veuillez noter qu&apos;il s&apos;agit d&apos;un USFM non standard, donc ce marqueur ne devrait pas être utilisé si vous soumettez ce même fichier à la bibliothèque biblique numérique.</text:span><text:span text:style-name="T39"/></text:p>
   <text:h text:style-name="P64" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark-start text:name="_Toc233871064"/><text:span text:style-name="T39">Je n’aime pas le nom « Application biblique ». Avez-vous pensé à appeler l&apos;application autre chose ?</text:span><text:bookmark-end text:name="_Toc233871064"/><text:span text:style-name="T39"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Le programme qui vous permet de définir et de construire des applications est appelé “Scripture App Builder” mais l&apos;application elle-même n&apos;a pas de nom. C&apos;est à vous de choisir le nom des applications que vous construisez.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Vous ne verrez pas &quot;App Scripture&quot; nulle part dans les applications que vous créez, alors n&apos;hésitez pas à utiliser un nom approprié dans une langue internationale, nationale ou locale. Les noms d&apos;applications qui fonctionnent bien dans certains contextes seront moins utiles dans d&apos;autres contextes, c&apos;est pourquoi SAB vous permet de le contextualiser.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table21" table:style-name="Table21">
    <table:table-column table:style-name="Table21.A"/>
    <table:table-column table:style-name="Table21.B"/>
    <table:table-row table:style-name="Table21.1">
     <table:table-cell table:style-name="Table21.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table21.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Les sections suivantes suivent la structure du menu du projet dans le constructeur d&apos;applications bibliques. Chaque sujet du menu principal du projet a des sous-catégories pour chaque sous-menu et onglets.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P45" text:outline-level="1"><text:bookmark-start text:name="_Toc233871065"/>La barre de menu SAB<text:bookmark-end text:name="_Toc233871065"/></text:h>
   <text:p text:style-name="Standard"><text:soft-page-break/>La barre de menu s&apos;affiche en haut de la fenêtre du programme de construction d&apos;applications bibliques (Linux et Windows) ou en haut de l&apos;écran (Mac).</text:p>
   <text:p text:style-name="Standard"><text:s/></text:p>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Picture 1986647592" text:anchor-type="as-char" svg:width="2.1043in" svg:height="0.3335in" draw:z-index="0"><draw:image xlink:href="SAB02/14.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871066"/>The <text:span text:style-name="T88">File</text:span> menu<text:bookmark-end text:name="_Toc233871066"/></text:h>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871067"/>Nouvelle application…<text:bookmark-end text:name="_Toc233871067"/></text:h>
   <text:p text:style-name="Standard">Ceci lance l&apos;assistant <text:span text:style-name="T51">New App</text:span>. Voir <text:a xlink:type="simple" xlink:href="#_How_to_build" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Comment construire votre première application</text:span></text:span></text:a> pour plus de détails.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871068"/>Ouvrir l&apos;app…<text:bookmark-end text:name="_Toc233871068"/></text:h>
   <text:p text:style-name="Standard">Ceci ouvre la boîte de dialogue Sélectionner le projet d&apos;application. Pour ouvrir un projet d&apos;application, trouvez et sélectionnez son fichier <text:span text:style-name="T51">.appDef</text:span>. Ceci se trouve dans le dossier du projet sous Projets d&apos;App. Voir <text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment SAB stocke vos fichiers de données de projet</text:span></text:a>.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871069"/>Ouvrir plusieurs applications…<text:bookmark-end text:name="_Toc233871069"/></text:h>
   <text:p text:style-name="Standard">Ceci affichera une liste de vos projets d&apos;application les plus récents modifiés. Cochez la case de sélection pour chacun de ceux que vous voulez ouvrir et SAB les chargera tous dans la vue de l&apos;arborescence du projet.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871070"/>Ouvrir l&apos;application depuis Scriptoria…<text:bookmark-end text:name="_Toc233871070"/></text:h>
   <text:p text:style-name="Standard">Si votre projet a été téléchargé dans Scriptoria, en choisissant ce lien de menu vous permettra d&apos;entrer dans l&apos;URL du projet Scriptoria, télécharger le projet et le charger dans SAB.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871071"/>Fermer<text:bookmark-end text:name="_Toc233871071"/></text:h>
   <text:p text:style-name="Standard">Ceci fermera le projet actuellement sélectionné dans l&apos;arborescence du projet.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871072"/>Enregistrer<text:bookmark-end text:name="_Toc233871072"/></text:h>
   <text:p text:style-name="Standard">Cela sauvegardera le projet en cours, et c&apos;est la même chose que de cliquer sur le bouton Enregistrer dans la barre d&apos;outils.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871073"/>Enregistrer tout<text:bookmark-end text:name="_Toc233871073"/></text:h>
   <text:p text:style-name="Standard">Ceci sauvegardera tous les projets non enregistrés.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871074"/><text:soft-page-break/>Recharger l&apos;application<text:bookmark-end text:name="_Toc233871074"/></text:h>
   <text:p text:style-name="Standard">Ceci va recharger la dernière version enregistrée de votre projet d&apos;application, en effaçant toutes les modifications que vous aviez apportées depuis cette date.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871075"/>Copier l&apos;application<text:bookmark-end text:name="_Toc233871075"/></text:h>
   <text:p text:style-name="Standard">Ceci va créer une image miroir du projet en cours, par défaut, en ajoutant le mot «<text:span text:style-name="T51">(Copie)</text:span>» au nom du projet pour le distinguer du projet copié. Cela peut être utile pour créer des projets similaires, mais pour différentes langues, ou pour créer un projet de test à expérimenter.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table22" table:style-name="Table22">
    <table:table-column table:style-name="Table22.A"/>
    <table:table-column table:style-name="Table22.B"/>
    <table:table-row table:style-name="Table22.1">
     <table:table-cell table:style-name="Table22.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table22.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">The project copy </text:span><text:span text:style-name="T94">will have the same package name as the original</text:span><text:span text:style-name="T89">, so be sure to change it to avoid confusion or overwriting the original project installation.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871076"/>Voir le dossier du projet<text:bookmark-end text:name="_Toc233871076"/></text:h>
   <text:p text:style-name="Standard">Ceci ouvrira le dossier du projet actuel. Ce dossier contient le fichier de configuration .appDef du projet et les sous-dossiers de données du projet. Voir <text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment SAB stocke vos fichiers de données de projet</text:span></text:a>.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table23" table:style-name="Table23">
    <table:table-column table:style-name="Table23.A"/>
    <table:table-column table:style-name="Table23.B"/>
    <table:table-row table:style-name="Table23.1">
     <table:table-cell table:style-name="Table23.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table23.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Si vous voulez partager votre projet d&apos;application avec quelqu&apos;un d&apos;autre (i.e. quelqu&apos;un qui peut vous aider à tester et à trouver des problèmes avec votre application), vous devrez leur donner votre dossier de projet et tout ce qu&apos;il contient. Ils peuvent le copier dans leur propre dossier de projets d&apos;applications, l&apos;ouvrir dans SAB et utiliser le leur, stockage temporaire de clés pour construire, exécuter et tester votre projet. Si des fichiers audio sont nécessaires pour votre application et qu&apos;ils ne sont pas stockés dans le sous-dossier audio de votre projet, vous devrez les copier séparément.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_View_APK_Output"/><text:bookmark-start text:name="_Toc233871077"/>Voir le dossier de sortie APK<text:bookmark-end text:name="_Toc233871077"/></text:h>
   <text:p text:style-name="Standard">Cela ouvrira le dossier de sortie de SAB où se trouvent tous les fichiers APK compilés, prêts à être copiés sur un téléphone pour tester ou partager avec d&apos;autres. Vous pouvez modifier le dossier de sortie par défaut sous <text:a xlink:type="simple" xlink:href="#_The_Default_Folders" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Paramètres </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Dossiers par défaut</text:span></text:span></text:a><text:span text:style-name="T51"> </text:span>dans la barre de menu SAB.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871078"/>Voir le dossier de sortie IPA<text:bookmark-end text:name="_Toc233871078"/></text:h>
   <text:p text:style-name="Standard">Cela ouvrira le dossier de sortie du SAB où se trouvent tous les fichiers IPA (iOS) compilés, prêt à être copié sur un téléphone pour tester ou partager avec d&apos;autres. </text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871079"/>Voir le dossier de sortie PWA<text:bookmark-end text:name="_Toc233871079"/></text:h>
   <text:p text:style-name="Standard">Cela ouvrira le dossier de sortie du SAB où se trouvent tous les fichiers PWA compilés, prêts à être copiés sur le site Web.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871080"/>Quitter<text:bookmark-end text:name="_Toc233871080"/></text:h>
   <text:p text:style-name="Standard">Utilisez ceci pour fermer le constructeur d&apos;applications bibliques. </text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871081"/><text:soft-page-break/>The <text:span text:style-name="T88">Build</text:span> menu<text:bookmark-end text:name="_Toc233871081"/></text:h>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871082"/>Construire l&apos;APK de l&apos;application Android<text:bookmark-end text:name="_Toc233871082"/></text:h>
   <text:p text:style-name="Standard">Ce lien de menu lancera la compilation du projet actuellement sélectionné, dupliquant les fonctionnalités du bouton <text:span text:style-name="T51">Build Android App APK</text:span> dans la barre d&apos;outils SAB. Notez que les APK multiples, spécifiques à l&apos;appareil seront construits au lieu d&apos;un APK complet si l&apos; <text:span text:style-name="T51">Générer des APKs…</text:span> option is selected under the <text:a xlink:type="simple" xlink:href="#_The_Multiple_APKs" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">App </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51"> APK </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51"> Multiple APKs</text:span></text:span></text:a> tab.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871083"/>Construire le pack d&apos;applications Android<text:bookmark-end text:name="_Toc233871083"/></text:h>
   <text:p text:style-name="Standard">Ce lien de menu initiera la compilation du projet actuellement sélectionné, en créant un pack d&apos;applications Android (AAB) plutôt qu&apos;un APK. Un fichier AAB est nécessaire pour la publication sur le Google Play Store. </text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871084"/>Créer une application Web Progressive (PWA)<text:bookmark-end text:name="_Toc233871084"/></text:h>
   <text:p text:style-name="Standard">Cela amorcera le processus de construction d&apos;une PWA. Pour plus de détails sur la configuration des composants nécessaires, veuillez consulter <text:a xlink:type="simple" xlink:href="#_Progressive_Web_Apps" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Application Web Progressive</text:span></text:span></text:a>.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871085"/>Construire le pack d&apos;actifs iOS<text:bookmark-end text:name="_Toc233871085"/></text:h>
   <text:p text:style-name="Standard">Pour plus de détails sur la construction d&apos;un pack d&apos;actifs iOS, voir <text:span text:style-name="T51">Installer et construire des applications sur un Mac</text:span> dans le menu Aide <text:span text:style-name="T51">SAB</text:span>.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871086"/>Construire plusieurs applications<text:bookmark-end text:name="_Toc233871086"/></text:h>
   <text:p text:style-name="Standard">Dans certains cas, il peut être opportun de définir plusieurs compilations d&apos;applications en cours à la fois. Cependant, cela peut prendre beaucoup de temps, selon la mémoire disponible. La sélection de Build Multiple Apps affiche une boîte de dialogue listant les projets actuellement ouverts dans SAB. Vous pouvez cocher ou décocher la case à côté de chaque projet d&apos;application pour sélectionner s&apos;il est construit. Utilisez la liste déroulante pour choisir si vous voulez construire des APK ou des packs d&apos;applications Android.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871087"/>Installer le dernier APK sur l&apos;appareil<text:bookmark-end text:name="_Toc233871087"/></text:h>
   <text:p text:style-name="Standard">Ceci duplique les fonctionnalités de l&apos; <text:span text:style-name="T51">Installer APK...</text:span> sur la barre d&apos;outils SAB. Si un téléphone est connecté et configuré pour le débogage USB, SAB tentera de copier et de lancer le dernier APK du projet actuellement sélectionné. Voir <text:a xlink:type="simple" xlink:href="#_Installing_the_app" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Installer l&apos;application sur votre téléphone</text:span></text:span></text:a>. Si aucun APK n&apos;est trouvé pour le projet, SAB vous demandera d&apos;en compiler un.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871088"/>Exporter la sécurité des données en CSV<text:bookmark-end text:name="_Toc233871088"/></text:h>
   <text:p text:style-name="Standard">Publier une application sur le Google Play Store nécessite que vous spécifiiez une série de réponses aux questions de sécurité des données. Selecting <text:span text:style-name="T51">Export Data Safety to CSV</text:span> will export a <text:span text:style-name="T88">comma separated values</text:span> file into the APK output folder. Ce fichier peut être importé dans le cadre du processus de publication.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871089"/>The <text:span text:style-name="T88">Tools</text:span> menu<text:bookmark-end text:name="_Toc233871089"/></text:h>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_Settings…"/><text:bookmark-start text:name="_Toc233871090"/>Paramètres…<text:bookmark-end text:name="_Toc233871090"/></text:h>
   <text:p text:style-name="Standard"><text:soft-page-break/>La boîte de dialogue Paramètres vous permet de modifier les paramètres et dossiers de construction SAB.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_The_Code_Libraries"/><text:bookmark-start text:name="_Toc233871091"/>The <text:span text:style-name="T88">Code Libraries</text:span> tab<text:bookmark-end text:name="_Toc233871091"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Emplacement JDK</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Le Kit de développement Java est un ensemble nécessaire de bibliothèques de code pour construire des applications. Le processus d&apos;installation normale de SAB devrait vous demander de télécharger et d&apos;installer le JDK, et le champ <text:span text:style-name="T51">emplacement JDK</text:span> devrait afficher l&apos;emplacement des fichiers installés. Si pour une raison quelconque, c&apos;est vide, ou vous devez changer la version du JDK, vous pouvez soit <text:span text:style-name="T51">Parcourir</text:span> vers une autre version déjà sur votre ordinateur, soit utiliser <text:span text:style-name="T51">Installer JDK…</text:span> pour télécharger et installer une nouvelle version.</text:p>
   <text:p text:style-name="Standard"><text:s/></text:p>
   <text:p text:style-name="P10" loext:marker-style-name="T51"><text:span text:style-name="T51">Localisation du constructeur d&apos;applications</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">C&apos;est le dossier dans lequel SAB a été installé. Si vous avez besoin d&apos;installer une version précédente à des fins de test, vous pouvez le télécharger à partir de la section <text:span text:style-name="T51">Versions Précédentes</text:span> en bas de la page de téléchargement <text:a xlink:type="simple" xlink:href="https://software.sil.org/scriptureappbuilder/download/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">SAB</text:span></text:a> et y naviguer ici.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_The_Android_SDK"/><text:bookmark-start text:name="_Toc233871092"/>The <text:span text:style-name="T88">Android SDK</text:span> tab<text:bookmark-end text:name="_Toc233871092"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Emplacement du SDK Android</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Le kit de développement de logiciels Android est un ensemble de bibliothèques de code requises pour construire des applications. Le processus d&apos;installation normale de SAB devrait vous demander de télécharger et d&apos;installer le SDK Android, et le champ <text:span text:style-name="T51">emplacement Android SDK</text:span> devrait afficher l&apos;emplacement des fichiers installés. Si pour une raison quelconque, c&apos;est vide, ou vous devez changer la version du SDK, vous pouvez soit <text:span text:style-name="T51">Parcourir</text:span> vers une autre version déjà sur votre ordinateur, ou utilisez <text:span text:style-name="T51">Installer Android SDK…</text:span> pour télécharger et installer une nouvelle version.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Pack SDK Android</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Si installé correctement, les quatre paquets SDK devraient avoir des numéros de version verts affichés (voir l&apos;exemple ci-dessous).</text:p>
   <text:p text:style-name="P308" loext:marker-style-name="T51"/>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr4" draw:name="Picture 1986647595" text:anchor-type="as-char" svg:width="5.9791in" svg:height="1.8543in" draw:z-index="0"><draw:image xlink:href="SAB02/15.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Cliquez sur <text:span text:style-name="T51">Vérifier l&apos;installation</text:span> pour vous assurer que les quatre paquets SDK sont installés. Si l&apos;un des quatre champs est listé comme « Non Trouvé », cliquez sur <text:span text:style-name="T51">Installer Android SDK…</text:span> pour installer ou réinstaller les paquets.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871093"/>The <text:span text:style-name="T88">Defaults</text:span> tab<text:bookmark-end text:name="_Toc233871093"/></text:h>
   <text:p text:style-name="Standard">Actuellement, l&apos;onglet Défaut a un champ…</text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Début du nom du paquet</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Utilisez ce champ pour entrer les parties de début par défaut d&apos;un nom de paquet que vous utilisez généralement. Voir <text:a xlink:type="simple" xlink:href="#_How_should_I_1" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Comment dois-je choisir le nom du package d&apos;application ?</text:span></text:span></text:a> pour plus de détails.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_The_Default_Folders"/><text:bookmark-start text:name="_Toc233871094"/>The <text:span text:style-name="T88">Default Folders</text:span> tab<text:bookmark-end text:name="_Toc233871094"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Répertoire des projets d&apos;application par défaut</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Utilisez ce champ pour changer l&apos;emplacement par défaut où SAB recherche les projets d&apos;application.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P10" loext:marker-style-name="T51"><text:span text:style-name="T51">Dossier de sortie pour les applications Android</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Utilisez ce champ pour changer l&apos;emplacement par défaut où SAB place vos fichiers APK compilés.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871095"/>The <text:span text:style-name="T88">Export Folders</text:span> tab<text:bookmark-end text:name="_Toc233871095"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Répertoire de sortie HTML</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Utilisez ce champ pour changer l&apos;emplacement par défaut où SAB place vos fichiers HTML exportés.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Répertoire de sortie EPUB</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Utilisez ce champ pour changer l&apos;emplacement par défaut où SAB place vos fichiers EPUB exportés.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">PWA Dossier de Sortie</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Utilisez ce champ pour changer l&apos;emplacement par défaut où SAB place vos fichiers PWA exportés.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_The_Build_Settings"/><text:bookmark-start text:name="_Toc233871096"/>The <text:span text:style-name="T88">Build Settings</text:span> tab<text:bookmark-end text:name="_Toc233871096"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:soft-page-break/><text:span text:style-name="T51">Mode Hors ligne</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Le programme qui compile votre projet pour créer un fichier d&apos;installation d&apos;application s&apos;appelle Gradle. La première fois que vous compilez votre application, Gradle devra télécharger des fichiers supplémentaires à exécuter. À partir de là, il essaiera de vérifier de temps à autre si d&apos;autres mises à jour sont nécessaires. Si vous n&apos;avez pas d&apos;internet disponible après le téléchargement supplémentaire initial, cochez la case <text:span text:style-name="T51">Utiliser le compilateur hors ligne</text:span>. Il se peut toutefois que vous deviez décocher cette option lorsque vous avez une connexion internet pour obtenir des mises à jour.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Reconstruction rapide de l&apos;APK</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">RAB peut accélérer la compilation de l&apos;application en réutilisant des fichiers compilés depuis la dernière version. Si vous ne voyez pas les changements attendus dans votre application, essayez de décocher cette option.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Memory Use</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Normalement, vous n&apos;avez pas à modifier cette valeur. Le texte explicatif qui l&apos;accompagne explique quand vous devrez peut-être le modifier.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871097"/>The <text:span text:style-name="T88">Build Folders</text:span> tab<text:bookmark-end text:name="_Toc233871097"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Dossier de cache Gradle</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Normalement, vous devez laisser ce champ vide pour utiliser le dossier de cache par défaut, sauf si vous avez une raison spécifique de choisir un autre emplacement.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Répertoire de construction</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Normalement, vous devriez laisser ce champ dans le dossier par défaut, à moins que vous n&apos;ayez une raison spécifique de choisir un autre emplacement.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_The_After_Build"/><text:bookmark-start text:name="_Toc233871098"/>The <text:span text:style-name="T88">After Build</text:span> tab<text:bookmark-end text:name="_Toc233871098"/></text:h>
   <text:p text:style-name="Standard">Vous pouvez configurer SAB pour qu&apos;il installe et lance automatiquement une application après qu&apos;elle soit compilée si votre téléphone est connecté via un câble de données USB et configuré pour le débogage USB. Voir <text:a xlink:type="simple" xlink:href="#_Installing_the_app" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Installer l&apos;application sur votre téléphone</text:span></text:span></text:a>. Vous aurez peut-être besoin d&apos;une application tierce pour déterminer l&apos;architecture de votre téléphone.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871099"/>The <text:span text:style-name="T88">Interface</text:span> tab<text:bookmark-end text:name="_Toc233871099"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T51"><text:span text:style-name="T51">Interface utilisateur</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/>Utilisez la liste déroulante de l&apos;interface utilisateur pour sélectionner la langue par défaut de l&apos;interface utilisateur pour votre version de Scripture App Builder. Vous pouvez également changer cela en utilisant le sélecteur de langue de l&apos;interface situé à l&apos;extrême droite de la barre d&apos;outils.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Thème</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Sélectionnez le thème pour l&apos;interface SAB.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Thème sombre</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Sélectionnez le thème sombre pour l&apos;interface SAB. Ceci sera utilisé si votre ordinateur a activé son mode de thème sombre. Si vous voulez que SAB utilise le thème normal, même si le thème sombre de l&apos;ordinateur est actif, sélectionnez <text:span text:style-name="T51">Toujours utiliser le thème principal</text:span>.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871100"/>The <text:span text:style-name="T88">Files</text:span> tab<text:bookmark-end text:name="_Toc233871100"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Fichiers Audio</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Les fichiers audio peuvent comprendre certains des plus grands fichiers de données de projet. Utilisez le paramètre ici pour dire à SAB si vous voulez conserver les fichiers audio dans leur emplacement source ou les copier dans le dossier du projet <text:a xlink:type="simple" xlink:href="#_Project-specific_data_folders" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">sous-dossier de données audio</text:span></text:span></text:a>. Cette deuxième option facilitera l&apos;enregistrement ou le partage du projet mais doublera la taille que les fichiers audio prendront sur votre ordinateur.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Réglage fin des Timings</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Comme expliqué dans le texte des onglets, SAB cherchera automatiquement dans le dossier spécifié les fichiers de synchronisation enregistrés et les copiera dans le projet. Vous pouvez modifier l&apos;emplacement si nécessaire.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871101"/>The <text:span text:style-name="T88">Slideshows</text:span> tab<text:bookmark-end text:name="_Toc233871101"/></text:h>
   <text:p text:style-name="Standard">Pour obtenir de l&apos;aide sur cet onglet, voir <text:span text:style-name="T51">Créer des vidéos Diaporama</text:span> dans le menu Aide <text:span text:style-name="T51">SAB</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871102"/>Créer une nouvelle boutique de clés…<text:bookmark-end text:name="_Toc233871102"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Un magasin de clés est un fichier de certificat numérique qui garantit que l&apos;application est légitime. Une application doit être signée de cette manière afin qu&apos;elle puisse être installée sur un téléphone. Vous pouvez utiliser un magasin de clés existant ou suivre cet assistant pour en créer une nouvelle. Ce processus est également inclus dans l&apos;assistant </text:span><text:a xlink:type="simple" xlink:href="#_How_to_build" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">&quot;Nouvelle application&quot;</text:span></text:span></text:a><text:span text:style-name="T39">.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Entrez un nouveau nom de fichier pour le keystore, tel que « keystore1 ». Spécifiez un mot de passe. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to continue.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Entrez un nom d&apos;alias pour une clé à créer dans votre nouveau magasin de clés, comme la clé par défaut « key1». Spécifiez un mot de passe, qui peut être le même que le mot de passe que vous avez entré sur la page précédente. </text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table24" table:style-name="Table24">
    <table:table-column table:style-name="Table24.A"/>
    <table:table-column table:style-name="Table24.B"/>
    <table:table-row table:style-name="Table24.1">
     <table:table-cell table:style-name="Table24.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T184"><text:span text:style-name="T83">&lt;unk&gt;</text:span><text:span text:style-name="T84"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table24.B1" office:value-type="string">
      <text:p text:style-name="P270" loext:marker-style-name="T89"><text:span text:style-name="T89">Il est très important de stocker le mot de passe de façon sécurisée pour votre magasin de clés. Une fois l&apos;application publiée, elle ne peut pas être mise à jour sans le mot de passe du magasin de clés. Assurez-vous que quelqu&apos;un d&apos;autre de votre organisation a accès aux mots de passe du magasin de clés de l&apos;application.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P86" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez </text:span><text:span text:style-name="T39">pour continuer.</text:span></text:p>
   <text:p text:style-name="P86" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Sur la page </text:span><text:span text:style-name="T53">Certificat Émetteur</text:span><text:span text:style-name="T39"> , fournissez des détails sur votre organisation dans au moins un des champs. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to continue.</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Un nouveau magasin de clés sera créé pour vous. Cliquez sur </text:span><text:span text:style-name="T52">Fermez</text:span><text:span text:style-name="T39">.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871103"/>Installer JDK…<text:bookmark-end text:name="_Toc233871103"/></text:h>
   <text:p text:style-name="P114" loext:marker-style-name="T39"><text:span text:style-name="T39">This menu item duplicates the </text:span><text:span text:style-name="T52">Install JDK</text:span><text:span text:style-name="T39"> feature under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Code_Libraries" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">Tools </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> Settings </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T71"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> Code Libraries</text:span></text:span></text:a><text:span text:style-name="T39"> tab.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871104"/>Installer Android SDK…<text:bookmark-end text:name="_Toc233871104"/></text:h>
   <text:p text:style-name="P114" loext:marker-style-name="T39"><text:span text:style-name="T39">This menu item duplicates the </text:span><text:span text:style-name="T52">Install Android SDK</text:span><text:span text:style-name="T39"> feature under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Android_SDK" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Tools </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> Settings </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> Android SDK</text:span></text:span></text:a><text:span text:style-name="T39"> tab.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871105"/>Vérifiez l&apos;installation d&apos;Android SDK…<text:bookmark-end text:name="_Toc233871105"/></text:h>
   <text:p text:style-name="P114" loext:marker-style-name="T39"><text:span text:style-name="T39">This menu item duplicates the </text:span><text:span text:style-name="T52">Check Android SDK Installation</text:span><text:span text:style-name="T39"> feature under the </text:span><text:a xlink:type="simple" xlink:href="#_The_Android_SDK" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Tools </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> Settings </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52"> Android SDK</text:span></text:span></text:a><text:span text:style-name="T39"> tab.</text:span></text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark text:name="_View_Logs…"/><text:bookmark-start text:name="_Toc233871106"/>Voir les journaux…<text:bookmark-end text:name="_Toc233871106"/></text:h>
   <text:p text:style-name="Standard">Comme SAB construit un fichier APK d&apos;application, il ouvre une fenêtre qui affiche les étapes internes qu&apos;il prend au fur et à mesure qu&apos;il compile l&apos;application. Une fois que vous fermez cette fenêtre (lorsque la compilation de l&apos;application est terminée), vous pouvez toujours voir la sortie ou toute information d&apos;erreur dans la fenêtre Voir les logs. Il y a deux onglets : l&apos;un pour toute information d&apos;erreur et l&apos;autre pour la sortie de la compilation. Ils sont utiles si vous avez besoin de comprendre pourquoi une compilation a échoué et/ou peut être envoyée à un spécialiste technique pour obtenir de l&apos;aide.</text:p>
   <text:h text:style-name="P74" text:outline-level="3"><text:bookmark-start text:name="_Toc233871107"/><text:soft-page-break/>Vérifiez l&apos;installation d&apos;aeneas…<text:bookmark-end text:name="_Toc233871107"/></text:h>
   <text:p text:style-name="P114" loext:marker-style-name="T39"><text:span text:style-name="T39">La sélection de ce lien de menu exécute un processus qui vérifie que aeneas a été installé correctement. Cela peut aider à résoudre des problèmes et/ou être envoyé à un spécialiste technique pour obtenir de l&apos;aide. Voici un exemple de vérification réussie de l&apos;installation :</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P98" loext:marker-style-name="T60"/>
   <text:p text:style-name="P101" loext:marker-style-name="T39"><draw:frame draw:style-name="fr4" draw:name="Picture 1986647591" text:anchor-type="as-char" svg:width="4.3291in" svg:height="2.9583in" draw:z-index="0"><draw:image xlink:href="SAB02/16.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="P87" loext:marker-style-name="T39"/>
   <text:p text:style-name="P87" loext:marker-style-name="T39"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871108"/>Le menu <text:span text:style-name="T88">Aide</text:span><text:bookmark-end text:name="_Toc233871108"/></text:h>
   <text:p text:style-name="Standard">Le menu Aide donne accès à un certain nombre de fonctionnalités utiles, de documents et de liens.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_Find_Settings_and"/><text:bookmark-start text:name="_Toc233871109"/>Trouver les paramètres et les fonctionnalités<text:bookmark-end text:name="_Toc233871109"/></text:h>
   <text:p text:style-name="Standard">Utilisez la boîte de dialogue <text:span text:style-name="T51">Rechercher les paramètres et les fonctionnalités</text:span> pour rechercher les paramètres de l&apos;application que vous souhaitez définir ou modifier. Commencez à taper n&apos;importe quel mot-clé dans la zone d&apos;entrée <text:span text:style-name="T51">Rechercher</text:span> et les paramètres possibles s&apos;afficheront ci-dessous. Double-cliquez sur un paramètre pour ouvrir cet emplacement dans SAB.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Cette fonctionnalité est également accessible à l&apos;aide de la fonction <text:span text:style-name="T51">Trouver…</text:span> sur le côté droit de la barre d&apos;outils du SAB.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871110"/>Documents d&apos;aide<text:bookmark-end text:name="_Toc233871110"/></text:h>
   <text:p text:style-name="Standard">Suivre <text:span text:style-name="T88">Trouver les paramètres et les fonctionnalités</text:span> sont une liste de documents utiles. Cliquer sur un élément ouvre un fichier PDF que vous pouvez enregistrer localement si vous le souhaitez.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871111"/>Site web de la communauté<text:bookmark-end text:name="_Toc233871111"/></text:h>
   <text:p text:style-name="Standard">SIL gère un site web communautaire où les utilisateurs peuvent poster des questions, des commentaires ou des demandes de fonctionnalités. La communauté des constructeurs d&apos;applications est très active et les membres aiment s&apos;entraider avec des besoins spécifiques. Si vous avez une question ou que vous essayez de faire quelque chose dans une application qui n&apos;est pas clairement spécifiée dans les documents d&apos;aide SAB rechercher une question comparable dans le site web de la communauté est une bonne première étape.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871112"/>Site Web de l&apos;Agent de Support Client<text:bookmark-end text:name="_Toc233871112"/></text:h>
   <text:p text:style-name="Standard">Ceci lance une page de navigateur qui fournit un assistant AI pour aider à répondre aux questions sur le SAB.</text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871113"/><text:soft-page-break/>À propos de l&apos;App Builder<text:bookmark-end text:name="_Toc233871113"/></text:h>
   <text:p text:style-name="Standard">Le SAB A propos de la boîte affiche la version actuelle et le numéro de compilation, les informations sur les droits d&apos;auteur et un lien vers le site Web du constructeur d&apos;applications bibliques.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P44" text:outline-level="1"><text:bookmark-start text:name="_Toc233871114"/>La barre d&apos;outils SAB<text:bookmark-end text:name="_Toc233871114"/></text:h>
   <text:p text:style-name="Standard">La barre d&apos;outils SAB est une série de boutons situés sous la barre de menus.</text:p>
   <text:p text:style-name="P295" loext:marker-style-name="T147"/>
   <text:p text:style-name="P3"><draw:frame draw:style-name="fr4" draw:name="Picture 1986647596" text:anchor-type="as-char" svg:width="5.3335in" svg:height="0.3437in" draw:z-index="0"><draw:image xlink:href="SAB02/17.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P65" text:outline-level="2"><text:bookmark-start text:name="_Toc233871115"/>Nouvelle application…<text:bookmark-end text:name="_Toc233871115"/></text:h>
   <text:p text:style-name="Standard">Ceci lance l&apos;assistant <text:span text:style-name="T51">New App</text:span>. Voir <text:a xlink:type="simple" xlink:href="#_How_to_build" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Comment construire votre première application</text:span></text:span></text:a> pour plus de détails.</text:p>
   <text:h text:style-name="P65" text:outline-level="2"><text:bookmark-start text:name="_Toc233871116"/>Enregistrer<text:bookmark-end text:name="_Toc233871116"/></text:h>
   <text:p text:style-name="Standard">Ceci enregistre le projet actuellement sélectionné.</text:p>
   <text:h text:style-name="P65" text:outline-level="2"><text:bookmark-start text:name="_Toc233871117"/>Enregistrer tout<text:bookmark-end text:name="_Toc233871117"/></text:h>
   <text:p text:style-name="Standard">Ceci enregistre tous les projets ouverts non enregistrés.</text:p>
   <text:h text:style-name="P65" text:outline-level="2"><text:bookmark-start text:name="_Toc233871118"/>Créer une application Android<text:bookmark-end text:name="_Toc233871118"/></text:h>
   <text:p text:style-name="Standard">Ce lien de menu lancera la compilation du projet actuellement sélectionné, dupliquant les fonctionnalités de l&apos;élément <text:span text:style-name="T51">Build Android App APK</text:span> dans le menu <text:span text:style-name="T51">Build</text:span>. Notez que les APK multiples, spécifiques à l&apos;appareil seront construits au lieu d&apos;un APK complet si l&apos; <text:span text:style-name="T51">Générer des APKs…</text:span> option is selected under the <text:span text:style-name="T51">App </text:span><text:span text:style-name="T72"></text:span><text:span text:style-name="T51"> APK </text:span><text:span text:style-name="T72"></text:span><text:span text:style-name="T51"> Multiple APKs</text:span> tab.</text:p>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871119"/>Installer APK…<text:bookmark-end text:name="_Toc233871119"/></text:h>
   <text:p text:style-name="Standard">Ceci duplique la fonctionnalité de l&apos;élément <text:span text:style-name="T51">Installer le dernier APK sur le périphérique</text:span> dans le menu <text:span text:style-name="T51">Build</text:span>. Si un téléphone est connecté et configuré pour le débogage USB, SAB tentera de copier et de lancer le dernier APK du projet actuellement sélectionné. Voir <text:a xlink:type="simple" xlink:href="#_Installing_the_app" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Installer l&apos;application sur votre téléphone</text:span></text:span></text:a>. Si aucun APK n&apos;est trouvé pour le projet, SAB vous demandera d&apos;en compiler un.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871120"/>Construire PWA<text:bookmark-end text:name="_Toc233871120"/></text:h>
   <text:p text:style-name="Standard"><text:soft-page-break/>Cela amorcera le processus de construction d&apos;une PWA. Pour plus de détails sur la configuration des composants nécessaires, veuillez consulter <text:a xlink:type="simple" xlink:href="#_Progressive_Web_Apps" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Application Web Progressive</text:span></text:span></text:a>.</text:p>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871121"/>Lancer PWA<text:bookmark-end text:name="_Toc233871121"/></text:h>
   <text:p text:style-name="Standard">Ceci tentera d&apos;exécuter la PWA compilée du projet actuel. Pour plus de détails sur la configuration des composants nécessaires, veuillez consulter <text:a xlink:type="simple" xlink:href="#_Progressive_Web_Apps" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Application Web Progressive</text:span></text:span></text:a>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P44" text:outline-level="1"><text:bookmark-start text:name="_Toc233871122"/>Le noeud de l&apos;arborescence de la racine du projet (nom du projet)<text:bookmark-end text:name="_Toc233871122"/></text:h>
   <text:p text:style-name="Standard">Vous pouvez ouvrir plusieurs projets à la fois dans le constructeur d&apos;applications Scripture. Les projets sont répertoriés par nom de projet dans la zone de menu du projet. Si vous cliquez sur le nom du projet (c&apos;est l&apos;arborescence racine), le résumé de l&apos;application apparaîtra dans la zone à droite.</text:p>
   <text:p text:style-name="P362" loext:marker-style-name="T185"><text:span text:style-name="T185">Sur cette page, vous verrez en un coup d&apos;œil le nom de l&apos;application, le nom du paquet, le numéro de version collections de livres (avec nombre de livres), fonctions d&apos;engagement, noms de polices, nombre de fichiers audio, etc.</text:span><text:span text:style-name="T185"/></text:p>
   <text:p text:style-name="P362" loext:marker-style-name="T185"><text:span text:style-name="T185">Si l&apos;application est prête à être construite, la carte du bas de la page sera verte avec un message « Prêt à construire ». Si l&apos;application n&apos;est pas prête à construire, la carte du bas de la page sera rose et une liste d&apos;étapes à suivre apparaîtra (la même liste qui s&apos;affiche si vous essayez de construire une application).</text:span><text:span text:style-name="T185"/></text:p>
   <text:p text:style-name="P364" loext:marker-style-name="T185"><text:span text:style-name="T185">La plupart des éléments de la page sont hyperliés, ce qui vous permet de vous déplacer directement vers les pages de configuration correspondantes. Mettre en pause votre souris sur un élément pour afficher son hyperlien, le cas échéant.</text:span><text:span text:style-name="T185"/></text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P44" text:outline-level="1"><text:bookmark-start text:name="_Toc233871123"/>Le menu du projet <text:span text:style-name="T88">App</text:span><text:bookmark-end text:name="_Toc233871123"/></text:h>
   <text:p text:style-name="Standard">These are the details for all the tabs under the <text:span text:style-name="T51">App</text:span> menu in the project tree view on the left side of the SAB screen.</text:p>
   <text:h text:style-name="P65" text:outline-level="2" loext:marker-style-name="T39"><text:bookmark text:name="_App_Name"/><text:bookmark-start text:name="_Toc233871124"/>Nom et Paquet<text:bookmark-end text:name="_Toc233871124"/><text:span text:style-name="T39"/></text:h>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871125"/>The <text:span text:style-name="T88">App Name</text:span> tab<text:bookmark-end text:name="_Toc233871125"/></text:h>
   <text:p text:style-name="Standard">Le nom de l&apos;application est ce que l&apos;utilisateur voit sur le téléphone sous l&apos;icône de l&apos;application. Selon les paramètres du téléphone, le nombre de lettres visibles dans le nom ne peut être que d&apos;environ 20 et peut être tronqué. Gardez cela à l&apos;esprit et gardez le nom court et descriptif. </text:p>
   <text:p text:style-name="Standard">Vous pouvez utiliser le bouton <text:span text:style-name="T51">Translations</text:span>… pour définir plusieurs noms d&apos;application, chacun basé sur la langue de l&apos;interface du téléphone (défini sous <text:a xlink:type="simple" xlink:href="#_The_Languages_tab" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51">Apparence </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72">&lt;unk&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51"> Interface </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T72">&lt;unk&gt;</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T51"> Langues</text:span></text:span></text:a>). Alternativement, vous ne pouvez avoir qu&apos;un seul nom dans la langue vernaculaire de la cible.<text:bookmark text:name="_Package"/></text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871126"/>The <text:span text:style-name="T88">Package</text:span> tab<text:bookmark-end text:name="_Toc233871126"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T94">Le nom du package d&apos;application doit être unique et ne peut pas changer une fois que l&apos;application est publiée.</text:span><text:span text:style-name="T39"> La norme pour un nom de package d&apos;application est de commencer par l&apos;adresse web inversée de l&apos;organisation de publication. . S&apos;il s&apos;agit des traducteurs de la Bible Wycliffe, le nom du paquet pourrait commencer par : </text:span></text:p>
   <text:p text:style-name="P302" loext:marker-style-name="T105"><text:span text:style-name="T105">org.wycliffe</text:span><text:span text:style-name="T105"/></text:p>
   <text:p text:style-name="P239" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">et sera suivi par quelque chose qui identifie la langue et le type de publication (Nouveau Testament, Bible, etc.), p. ex.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P21" loext:marker-style-name="T105"><text:span text:style-name="T105">org.wycliffe.cccc.nnnn.bible</text:span><text:span text:style-name="T105"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">où ‘cccc’ est le nom du pays et ‘nnnn’ est le nom de la langue.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table25" table:style-name="Table25">
    <table:table-column table:style-name="Table25.A"/>
    <table:table-column table:style-name="Table25.B"/>
    <table:table-row table:style-name="Table25.1">
     <table:table-cell table:style-name="Table25.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table25.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Vous devrez peut-être planifier à l&apos;avance lorsque vous aurez choisi un nom de paquet. Si vous avez juste un livre biblique à publier mais que vous avez l&apos;intention d&apos;ajouter plus de livres à l&apos;application comme ils sont disponibles, il vaut mieux ajouter le mot « Bible » plutôt que de mettre le nom du livre. De même, si vous pouvez publier une version texte d&apos;un seul livre ET un livre d&apos;histoire, ajoutez un mot descriptif au nom du paquet par exemple org.wycliffe.senegal.wolof.john.storybook</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Si vous travaillez pour une organisation de traduction biblique ou de publication, vous pourriez avoir des normes à suivre pour les noms de paquets, alors veuillez contacter votre coordinateur de publications numériques pour obtenir des conseils à ce sujet.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Une fois que vous avez publié votre application dans un magasin d&apos;applications, vous ne pouvez pas changer son nom de paquet plus tard si vous voulez que les utilisateurs continuent à recevoir des mises à jour. Le nom du package identifie de manière unique l&apos;application. Ceux qui installeront l&apos;application pourront trouver son nom de paquet sur leur appareil. Il apparaîtra également dans l&apos;adresse Web de votre application si vous le rendez disponible sur Google Play.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:s/></text:p>
   <table:table table:name="Table26" table:style-name="Table26">
    <table:table-column table:style-name="Table26.A"/>
    <table:table-column table:style-name="Table26.B"/>
    <table:table-row table:style-name="Table26.1">
     <table:table-cell table:style-name="Table26.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T63"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table26.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Puisque le nom du package sera visible par les utilisateurs dans l&apos;URL du Google Play Store, assurez-vous que le nom de votre paquet n&apos;inclut pas de détails sensibles ou de mots comme « Bible » ou « Écriture » si, à des fins de sécurité, vous ne voulez pas que cela soit évident.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T105"><text:span text:style-name="T39">If you are building apps for </text:span><text:span text:style-name="T52">test purposes </text:span><text:span text:style-name="T39">on your devices, you can use a package name beginning with com.example, e.g. </text:span><text:span text:style-name="T105">com.example.test.app123</text:span></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Mais n&apos;oubliez pas de le modifier avant de publier l&apos;application.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><text:soft-page-break/></text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871127"/>L&apos;onglet <text:span text:style-name="T88">Projet</text:span><text:bookmark-end text:name="_Toc233871127"/><text:bookmark text:name="_Project"/></text:h>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">L&apos;onglet Projet vous permet de nommer ou de renommer votre projet. Le <text:span text:style-name="T51">Nom du projet</text:span> n&apos;est pas vu par l&apos;utilisateur, mais c&apos;est important car SAB l&apos;utilise pour nommer le dossier de projet réel sur votre ordinateur (voir <text:a xlink:type="simple" xlink:href="#_Appendix_1:_How" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Comment SAB stocke les fichiers de données de votre projet</text:span></text:a>). Si vous utiliserez une organisation partenaire comme Kalaam Media pour publier votre projet sur le Play Store, il est utile pour eux si le nom du projet commence par le code de langue et un trait d&apos;union, p. ex.</text:p>
   <text:p text:style-name="Standard">loups-miracles de Jésus</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">You can assign a <text:span text:style-name="T51">Project Group</text:span> to nest similar projects together in SAB’s project tree view. Cela peut être utile si vous travaillez sur plusieurs langues. La création d&apos;un groupe de projet créera également un sous-dossier de groupe de projet dans votre dossier <text:span text:style-name="T51">projets d&apos;application</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table27" table:style-name="Table27">
    <table:table-column table:style-name="Table27.A"/>
    <table:table-column table:style-name="Table27.B"/>
    <table:table-row table:style-name="Table27.1">
     <table:table-cell table:style-name="Table27.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T66">&lt;unk&gt;</text:span><text:span text:style-name="T67"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table27.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Si vous modifiez un nom de projet ou un nom de groupe plus tard, vous devrez peut-être fermer tous les projets affectés dans SAB, regardez dans le dossier des projets d&apos;application et déplacez les projets dans leur groupe correct.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Le <text:span text:style-name="T51">Description du projet</text:span> est juste à vos propres fins et n&apos;est pas vu par l&apos;utilisateur.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871128"/>Android<text:bookmark-end text:name="_Toc233871128"/></text:h>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871129"/>L&apos;onglet APK<text:bookmark-end text:name="_Toc233871129"/></text:h>
   <text:p text:style-name="Standard">APK signifie &quot;Pack Android&quot; et est un fichier d&apos;installation d&apos;applications. Un fichier APK est le résultat de la compilation d&apos;une application en SAB et est le fichier qui doit être copié sur un téléphone cible pour installer et exécuter l&apos;application. En tant que tel, le nom de l&apos;APK n&apos;est important que pour le distinguer des autres fichiers. Si l&apos;utilisateur recevra l&apos;APK directement (via un transfert de fichier ou un message WhatsApp ou quelque chose de similaire), et donc sera en mesure de voir le nom du fichier, le nom de l&apos;APK devrait clairement faire référence au nom du projet ou de l&apos;application. Sélectionner la case à cocher à <text:span text:style-name="T51">Ajouter le nom de version</text:span> (nombre) au nom de fichier peut également aider à distinguer entre les versions. Si l&apos;application est installée depuis le Play Store, l&apos;utilisateur ne verra pas le fichier APK.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Le code <text:span text:style-name="T51">Version</text:span> est juste un numéro interne que vous pouvez utiliser au sein de votre projet comme des mises à jour internes.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">L&apos;onglet </text:span><text:span text:style-name="T93">Versions Android</text:span></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/>La plateforme <text:span text:style-name="T51">Target Android Platform</text:span> fait référence à la plateforme actuelle Android supportée par le constructeur d&apos;applications Scripture. C&apos;est la plate-forme requise fournie par Google qui met à jour cette exigence environ une fois par an. Toutes les nouvelles applications en cours de publication sur le Play Store doivent supporter cette version, et les applications existantes devront être mises à jour dans quelques années, selon les spécifications de Google. Les nouvelles versions de Scripture App Builder sont conçues pour suivre ces exigences et simplement pour compiler et republier l&apos;application avec la dernière version rend l&apos;application compatible.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">En revanche, la <text:span text:style-name="T51">Plate-forme Android minimale</text:span> peut être spécifiquement définie pour cibler une génération de téléphones Android en utilisant une version Android particulière ou ultérieure. En général, plus la plateforme est ancienne, plus le numéro de version est petit, plus le téléphone est ancien et peut exécuter l&apos;application. Cependant, si votre application utilise une fonctionnalité qui ne fonctionne que sur des téléphones plus récents, cette plateforme minimale doit être configurée en conséquence.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">L&apos;onglet </text:span><text:span text:style-name="T93">Emplacement d&apos;installation</text:span></text:p>
   <text:p text:style-name="Standard">Vous pouvez spécifier ici si l&apos;application est installée sur la mémoire de stockage externe d&apos;un téléphone (c&apos;est-à-dire une carte micro SD) ou sur la mémoire de stockage interne.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:bookmark text:name="_The_Multiple_APKs"/><text:span text:style-name="T51">The </text:span><text:span text:style-name="T93">Multiple APKs</text:span><text:span text:style-name="T51"> tab</text:span></text:p>
   <text:p text:style-name="Standard">Il y a 4 types d&apos;architectures de téléphone Android, et un fichier APK est conçu pour fonctionner sur n&apos;importe lequel d&apos;eux. Cependant, certaines fonctionnalités (par exemple, permettre l&apos;enregistrement en tant que vidéo ou l&apos;inclusion de GeckoView) peuvent rendre l&apos;APK beaucoup plus grand. Puisque ces fonctionnalités dépendent de l&apos;architecture du téléphone, des APK plus petits, spécifiques à l&apos;appareil (connus sous le nom de &quot;Android App Bundles&quot; ou AAB) peuvent être construits pour cibler chaque architecture. L&apos;inconvénient est que cela empêche le partage du paquet d&apos;application sur un autre téléphone avec une architecture différente.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table28" table:style-name="Table28">
    <table:table-column table:style-name="Table28.A"/>
    <table:table-column table:style-name="Table28.B"/>
    <table:table-row table:style-name="Table28.1">
     <table:table-cell table:style-name="Table28.A1" office:value-type="string">
      <text:p text:style-name="P271" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table28.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Pour publier sur le Play Store, vous devrez créer des packs d&apos;applications Android (AAB). Lorsqu&apos;un utilisateur installe une application depuis le Play Store, il reçoit l&apos;APK associé à l&apos;architecture spécifique de son téléphone et non pas une APK universelle. Pour créer explicitement des AABs, allez dans le menu </text:span><text:span text:style-name="T94">Compile</text:span><text:span text:style-name="T89"> dans la barre de menu principale SAB et sélectionnez </text:span><text:span text:style-name="T94">Compile le pack d&apos;applications Android</text:span><text:span text:style-name="T89">. Si vous utilisez Scriptoria, vous pouvez y créer les AABs.</text:span></text:p>
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Si vous voulez distribuer votre application sur des cartes SD ou d&apos;autres moyens directs sur n&apos;importe quel téléphone, vous devrez construire un APK.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871130"/>The <text:span text:style-name="T88">App Signing</text:span> tab<text:bookmark-end text:name="_Toc233871130"/></text:h>
   <text:p text:style-name="Standard">Votre application doit être « signée » pour avoir la permission d&apos;être installée sur un téléphone Android. Signer signifie fournir un moyen d&apos;autoriser son installation en confirmant qu&apos;il est effectivement créé par vous, le développeur, et n&apos;est pas un logiciel malveillant ou un virus (ou juste une application illégale) déguisé. Cela se fait en créant un fichier « certificat» chiffré protégé par mot de passe, appelé un magasin de clés.</text:p>
   <text:p text:style-name="Standard"><text:s/></text:p>
   <text:p text:style-name="Standard">Si vous n&apos;en avez pas déjà un, créez un magasin de clés en cliquant sur le bouton <text:span text:style-name="T51">Créer une boutique de clés</text:span>… qui lance l&apos;assistant <text:span text:style-name="T51">Créer une nouvelle boutique de clés</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table29" table:style-name="Table29">
    <table:table-column table:style-name="Table29.A"/>
    <table:table-column table:style-name="Table29.B"/>
    <table:table-row table:style-name="Table29.1">
     <table:table-cell table:style-name="Table29.A1" office:value-type="string">
      <text:p text:style-name="P271" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table29.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Si vous le souhaitez, vous pouvez utiliser le même magasin de clés pour toutes vos applications. Cependant, pour diverses raisons, vous pouvez vouloir avoir un seul, boutique de clés partagée pour une sélection d&apos;applications — peut-être toutes les applications pour une langue particulière. Si vous avez besoin de donner vos projets à quelqu&apos;un d&apos;autre, il aura besoin du mot de passe pour pouvoir changer l&apos;application.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P235" loext:marker-style-name="T39"/>
   <text:list text:style-name="WWNum95">
    <text:list-item>
     <text:p text:style-name="P365" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Entrez un nouveau nom de fichier pour le keystore, tel que « keystore1 ». Spécifiez un mot de passe. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to continue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum95">
    <text:list-item>
     <text:p text:style-name="P365" loext:marker-style-name="T39"><text:span text:style-name="T39">Entrez un nom d&apos;alias pour une clé à créer dans votre nouveau magasin de clés, comme la clé par défaut « key1». Spécifiez un mot de passe, qui peut être le même que le mot de passe que vous avez entré sur la page précédente. </text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table30" table:style-name="Table30">
    <table:table-column table:style-name="Table30.A"/>
    <table:table-column table:style-name="Table30.B"/>
    <table:table-row table:style-name="Table30.1">
     <table:table-cell table:style-name="Table30.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table30.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Il est très important de stocker le mot de passe de façon sécurisée pour votre magasin de clés. Une fois l&apos;application publiée, elle ne peut pas être mise à jour sans le mot de passe du magasin de clés. Assurez-vous que quelqu&apos;un d&apos;autre de votre organisation a accès aux mots de passe du magasin de clés de l&apos;application.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P88" loext:marker-style-name="T39"/>
   <text:p text:style-name="P366" loext:marker-style-name="T39"><text:span text:style-name="T39">Cliquez </text:span><text:span text:style-name="T39">pour continuer.</text:span></text:p>
   <text:p text:style-name="P88" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum95">
    <text:list-item>
     <text:p text:style-name="P365" loext:marker-style-name="T39"><text:span text:style-name="T39">On the </text:span><text:span text:style-name="T53">Certificate Issuer</text:span><text:span text:style-name="T39"> page, provide details of your organisation in at least one of the fields. Click </text:span><text:span text:style-name="T52">Next</text:span><text:span text:style-name="T39"> to continue.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:list text:continue-numbering="true" text:style-name="WWNum95">
    <text:list-item>
     <text:p text:style-name="P365" loext:marker-style-name="T39"><text:span text:style-name="T39">Un nouveau magasin de clés sera créé pour vous. Cliquez sur </text:span><text:span text:style-name="T52">Fermez</text:span><text:span text:style-name="T39">.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P83" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez le porte-clés désiré et saisissez le mot de passe.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871131"/>The <text:span text:style-name="T88">App Registration</text:span> tab<text:bookmark-end text:name="_Toc233871131"/></text:h>
   <text:p text:style-name="Standard">Ceci fournit des paramètres pour l&apos;enregistrement requis de votre application.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871132"/>L&apos;onglet <text:span text:style-name="T88">Autorisations</text:span><text:bookmark-end text:name="_Toc233871132"/></text:h>
   <text:p text:style-name="Standard">Cet onglet liste toutes les autorisations requises tirées des options sélectionnées dans le projet d&apos;application.</text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/></text:p>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871133"/>iOS<text:bookmark-end text:name="_Toc233871133"/></text:h>
   <text:p text:style-name="Standard">Cet onglet sert à construire des applications iOS. Pour plus de détails à ce sujet, veuillez consulter le document <text:span text:style-name="T93">Installation et construction d&apos;applications sur un Mac</text:span> dans le menu <text:span text:style-name="T51">Aide</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P52" text:outline-level="2"><text:bookmark-start text:name="_Toc233871134"/>À propos de<text:bookmark-end text:name="_Toc233871134"/></text:h>
   <text:p text:style-name="P10" loext:marker-style-name="T39"><text:span text:style-name="T39">Every app must have an About page, which is displayed to the user when they select </text:span><text:span text:style-name="T52">About</text:span><text:span text:style-name="T39"> from the bottom of the app’s navigation drawer menu.</text:span></text:p>
   <text:p text:style-name="P228" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">To define the About page for your app:</text:span><text:span text:style-name="T39"/></text:p>
   <text:list text:style-name="WWNum41">
    <text:list-item>
     <text:p text:style-name="P367" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez </text:span><text:span text:style-name="T52">À propos de</text:span><text:span text:style-name="T39"> dans l&apos;arborescence des applications à gauche de l&apos;écran.</text:span></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P367" loext:marker-style-name="T39"><text:span text:style-name="T39">Entrez le texte à afficher sur la page À propos de l&apos;application.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P367" loext:marker-style-name="T39"><text:span text:style-name="T39">Sélectionnez l&apos;onglet </text:span><text:span text:style-name="T52">Visionneuse</text:span><text:span text:style-name="T39"> pour voir comment le texte apparaîtra dans l&apos;application.</text:span></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871135"/>Quelles informations devrais-je inclure dans la page À propos ?<text:bookmark-end text:name="_Toc233871135"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">La page À propos peut contenir n&apos;importe quelle information. Ce que vous incluez est votre choix, mais les éléments généralement inclus comprennent :</text:span><text:span text:style-name="T39"/></text:p>
   <text:list xml:id="list3727395977" text:style-name="WWNum5">
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">The app name and version</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">The name of the organization publishing the app</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">Copyright et informations de licence pour le contenu de l&apos;application (textes, images, audio). Dans la plupart des cas, les contrats de licence vous obligeront à inclure ces renseignements.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">Informations sur les droits d&apos;auteur pour l&apos;application elle-même.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">Link to your website</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:soft-page-break/><text:span text:style-name="T39">Link to a privacy policy</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">Informations de contact, comme une adresse électronique ou un numéro de téléphone.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P368" loext:marker-style-name="T39"><text:span text:style-name="T39">Une image de marque pour votre organisation locale et/ou l&apos;image d&apos;icône pour votre application.</text:span><text:span text:style-name="T39"/></text:p>
    </text:list-item>
   </text:list>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_Which_formatting_codes"/><text:bookmark-start text:name="_Toc233871136"/>Quels codes de formatage puis-je utiliser dans la page À propos ?<text:bookmark-end text:name="_Toc233871136"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">You can use the following formatting codes:</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table31" table:style-name="Table31">
    <table:table-column table:style-name="Table31.A"/>
    <table:table-column table:style-name="Table31.B"/>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Texte Gras</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Surtournez le texte que vous voulez en gras avec </text:span><text:span text:style-name="T160">&lt;b&gt;</text:span><text:span text:style-name="T39"> et </text:span><text:span text:style-name="T160">&lt;/b&gt;</text:span><text:span text:style-name="T39"> marqueurs.</text:span></text:p>
      <text:p text:style-name="P370" loext:marker-style-name="T39"><text:span text:style-name="T39">Exemple : </text:span><text:span text:style-name="T160">&lt;b&gt;</text:span><text:span text:style-name="T39">Ceci est en gras</text:span><text:span text:style-name="T160">&lt;/b&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Italic text</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Entourez le texte que vous voulez en italique avec </text:span><text:span text:style-name="T160">&lt;i&gt;</text:span><text:span text:style-name="T39"> et </text:span><text:span text:style-name="T160">&lt;/i&gt;</text:span><text:span text:style-name="T39"> marqueurs.</text:span></text:p>
      <text:p text:style-name="P370" loext:marker-style-name="T39"><text:span text:style-name="T39">Exemple : </text:span><text:span text:style-name="T160">&lt;i&gt;</text:span><text:span text:style-name="T39">Ceci est en italique</text:span><text:span text:style-name="T160">&lt;/i&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Texte souligné</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Surtournez le texte que vous voulez soulignés avec </text:span><text:span text:style-name="T160">&lt;u&gt;</text:span><text:span text:style-name="T39"> et </text:span><text:span text:style-name="T160">&lt;/u&gt;</text:span><text:span text:style-name="T39"> marqueurs.</text:span></text:p>
      <text:p text:style-name="P370" loext:marker-style-name="T39"><text:span text:style-name="T39">Exemple : </text:span><text:span text:style-name="T160">&lt;u&gt;</text:span><text:span text:style-name="T39">Ceci est souligné</text:span><text:span text:style-name="T160">&lt;/u&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Lien vers le site</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T160"><text:span text:style-name="T39">Utiliser le format </text:span><text:span text:style-name="T160">[text](url)</text:span><text:span text:style-name="T39">, où « texte» est le texte à afficher et « url» est l’adresse web.</text:span></text:p>
      <text:p text:style-name="P370" loext:marker-style-name="T39"><text:span text:style-name="T39">Exemple : Voici notre </text:span><text:span text:style-name="T160">[</text:span><text:span text:style-name="T39">site</text:span><text:span text:style-name="T160">](</text:span><text:span text:style-name="T39">http://www.example.com</text:span><text:span text:style-name="T160">)</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Liens e-mail</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T160"><text:span text:style-name="T39">Utiliser le format </text:span><text:span text:style-name="T160">[text](mailto:address)</text:span><text:span text:style-name="T39">, où « texte» est le texte à afficher et « mailto:address» contient l’adresse e-mail.</text:span></text:p>
      <text:p text:style-name="P370" loext:marker-style-name="T39"><text:span text:style-name="T39">Exemple : Contactez-nous par </text:span><text:span text:style-name="T160">[</text:span><text:span text:style-name="T39">email</text:span><text:span text:style-name="T160">](</text:span><text:span text:style-name="T39">mailto:contact@example.com</text:span><text:span text:style-name="T160">)</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Numéros de téléphone</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T160"><text:span text:style-name="T39">Utiliser le format </text:span><text:span text:style-name="T160">[text](tel:number)</text:span><text:span text:style-name="T39">, où « texte» est le texte à afficher et « tel:number» contient le numéro à appeler.</text:span></text:p>
      <text:p text:style-name="P370" loext:marker-style-name="T39"><text:span text:style-name="T39">Exemple : Notre nombre est </text:span><text:span text:style-name="T160">[</text:span><text:span text:style-name="T39">012-345-678</text:span><text:span text:style-name="T160">](</text:span><text:span text:style-name="T39">tel:012345678</text:span><text:span text:style-name="T160">)</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Image</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To add an image, first add the image file to the app illustrations (</text:span><text:a xlink:type="simple" xlink:href="#_Illustrations" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Images</text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T85"></text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39"> </text:span></text:span><text:span text:style-name="Internet_20_link"><text:span text:style-name="T52">Illustrations</text:span></text:span></text:a><text:span text:style-name="T39">) and use the following HTML code:</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;img src=&quot;image1.jpg&quot;/&gt;</text:span><text:span text:style-name="T160"/></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">You can specify width information, as a percentage (e.g. &quot;80%&quot;) or a fixed number of pixels (e.g. &quot;80px&quot;), or in the </text:span><text:span text:style-name="T52">img.about-image style</text:span><text:span text:style-name="T39">:</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T162"><text:span text:style-name="T162">&lt;img width=&quot;80%&quot; src=&quot;image1.jpg&quot;/&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Alignement gauche, droit ou centré</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour aligner du texte ou des images, entourez-les avec les marqueurs </text:span><text:span text:style-name="T160">&lt;div&gt;</text:span><text:span text:style-name="T39"> :</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;div align=&quot;center&quot;&gt;</text:span><text:span text:style-name="T39">Ceci est centré</text:span><text:span text:style-name="T160">&lt;/div&gt;</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;div align=&quot;left&quot;&gt;</text:span><text:span text:style-name="T39">Ceci est aligné à gauche</text:span><text:span text:style-name="T160">&lt;/div&gt;</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;div align=&quot;right&quot;&gt;</text:span><text:span text:style-name="T39">Ceci est aligné à droite</text:span><text:span text:style-name="T160">&lt;/div&gt;</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To center an image:</text:span><text:span text:style-name="T39"/></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;div align=&quot;center&quot;&gt;</text:span><text:span text:style-name="T39">&lt;img width=&quot;75%&quot; src=&quot;img2.jpg&quot;/&gt;</text:span><text:span text:style-name="T160">&lt;/div&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Styles</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour appliquer des styles (définis dans la page </text:span><text:span text:style-name="T52">Styles</text:span><text:span text:style-name="T39"> ) :</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;div class=&quot;q2&quot;&gt;</text:span><text:span text:style-name="T39">Ceci est stylisé comme poésie</text:span><text:span text:style-name="T160">&lt;/div&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Fontes</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">Pour appliquer des polices spécifiques au texte, assurez-vous d&apos;abord que les polices soient spécifiées sur la page </text:span><text:span text:style-name="T52">Fontes</text:span><text:span text:style-name="T39">. Utilisez ensuite la syntaxe suivante :</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T160"><text:span text:style-name="T160">&lt;span style=&quot;font-family:font1;&quot;&gt;</text:span><text:span text:style-name="T39">Ceci est dans la font1</text:span><text:span text:style-name="T160">&lt;/span&gt;</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T160">&lt;span style=&quot;font-family:font2;&quot;&gt;</text:span><text:span text:style-name="T39">Ceci est en font2</text:span><text:span text:style-name="T160">&lt;/span&gt;</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table31.1">
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Links within the About box</text:span><text:span text:style-name="T52"/></text:p>
      <text:p text:style-name="P305" loext:marker-style-name="T52"/>
     </table:table-cell>
     <table:table-cell table:style-name="Table31.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">Définissez un marqueur vers lequel aller quand une phrase de texte est cliquée. Par exemple, définir un marqueur de langue (Eng) pour permettre à l&apos;utilisateur de passer au texte à propos de la boîte de texte en anglais — si vous voulez avoir plusieurs langues dans le texte.</text:span><text:span text:style-name="T39"/></text:p>
      <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T160">&lt;h3 id=&quot;Eng&quot;&gt;Anglais&lt;/h3&gt;</text:span><text:span text:style-name="T105"> </text:span><text:span text:style-name="T39">(définit l&apos;id </text:span><text:span text:style-name="T39">associé à cette section)</text:span></text:p>
      <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T160">&lt;a href=&quot;#Eng&quot;&gt;(Cliquez ici pour la version anglaise)&lt;/a&gt;</text:span><text:span text:style-name="T105"> </text:span><text:span text:style-name="T39">(marque la section à sauter)</text:span></text:p>
      <text:p text:style-name="P240" loext:marker-style-name="T39"/>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table32" table:style-name="Table32">
    <table:table-column table:style-name="Table32.A"/>
    <table:table-column table:style-name="Table32.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Table32.1">
     <table:table-cell table:style-name="Table32.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T68">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table32.B1" office:value-type="string">
      <text:p text:style-name="P11" loext:marker-style-name="T88"><text:span text:style-name="T88">Pour centrer tout le texte dans la zone À Propos, ajoutez «</text:span><text:span text:style-name="T93">d&apos;alignement de texte : centre ;<text:line-break/></text:span><text:span text:style-name="T88">“ au CSS dans le corps </text:span><text:span text:style-name="T93">. bout</text:span><text:span text:style-name="T88"> Style UI</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="P9" loext:marker-style-name="T39"><draw:frame draw:style-name="fr2" draw:name="Frame6" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.8091in" draw:z-index="35" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table33" table:style-name="Table33">
       <table:table-column table:style-name="Table33.A"/>
       <table:table-column table:style-name="Table33.B"/>
       <table:table-row table:style-name="Table33.1">
        <table:table-cell table:style-name="Table33.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Pour modifier cette…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table33.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Ajuster le style de texte…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table33.1">
        <table:table-cell table:style-name="Table33.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">À propos du formatage de la page</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table33.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">body.about</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table33.1">
        <table:table-cell table:style-name="Table33.A3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Bloc d&apos;arrière-plan pour une image (voir </text:span><text:a xlink:type="simple" xlink:href="#_Which_formatting_codes" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link"><text:span text:style-name="T39">en dessous de</text:span></text:span></text:a><text:span text:style-name="T39"> sur la façon d&apos;ajouter une image)</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table33.B3" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Bloc div.about-image-</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table33.1">
        <table:table-cell table:style-name="Table33.A4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Taille de l&apos;image / largeur</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table33.B4" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">Image d&apos;abandon</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871137"/>Quelles variables puis-je utiliser dans la page À propos ?<text:bookmark-end text:name="_Toc233871137"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Vous pouvez utiliser certaines variables sur la page À Propos. Celles-ci sont remplacées par du texte dans l&apos;application. Par exemple, la variable %version-name% sera remplacée par le numéro de version de l&apos;application, par exemple « 1.2» dans l&apos;application.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <table:table table:name="Table34" table:style-name="Table34">
    <table:table-column table:style-name="Table34.A"/>
    <table:table-column table:style-name="Table34.B"/>
    <table:table-row table:style-name="Table34.1">
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Nom de l&apos;application</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To display the app name, use the variable </text:span><text:span text:style-name="T160">%app-name%</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table34.1">
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Version de l&apos;app</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To display the app version, use the variable </text:span><text:span text:style-name="T160">%version-name%</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table34.3">
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Copyright et Licence</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To display copyright and licensing information for text, audio and images:</text:span><text:span text:style-name="T39"/></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T160">%copyright-all% </text:span><text:span text:style-name="T39">all copyright information <text:line-break/> for all book collections</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T160">%ctexte opyright-text:CCC% </text:span><text:span text:style-name="T39">texte copyright pour la collection CCC</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T160">%copyright-audio:CCC% </text:span><text:span text:style-name="T39">droit d’auteur audio pour la collection CCC</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T160">%cimages avec droits d&apos;opyright-:CCC% </text:span><text:span text:style-name="T39">droits d&apos;auteur pour la collection CCC</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T160">%copyright-all:CCC% </text:span><text:span text:style-name="T39">texte, audio et images copyright <text:line-break/> pour la collecte CCC</text:span></text:p>
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">Remplacer la CCC par l&apos;ID de la collection du livre, par exemple « C01 ». Les informations proviennent de l&apos;onglet </text:span><text:span text:style-name="T52">Copyright &amp; Licensing</text:span><text:span text:style-name="T39"> pour cette collection de livres.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table34.3">
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Type de programme</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To display the program type (SAB), use the variable </text:span><text:span text:style-name="T160">%program-type%</text:span></text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="Table34.3">
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="Standard" loext:marker-style-name="T52"><text:span text:style-name="T52">Version du programme</text:span><text:span text:style-name="T52"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table34.A1" office:value-type="string">
      <text:p text:style-name="P371" loext:marker-style-name="T39"><text:span text:style-name="T39">To display the version of the program used to create the app, use the variable </text:span><text:span text:style-name="T160">%program-version%</text:span><text:bookmark text:name="_Hlk96437838"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P59" text:outline-level="2"><text:bookmark-start text:name="_Toc233871138"/>Sécurité<text:bookmark-end text:name="_Toc233871138"/></text:h>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark text:name="_App_Signing"/><text:bookmark-start text:name="_Toc233871139"/>The <text:span text:style-name="T88">Expiry</text:span> tab<text:bookmark-end text:name="_Toc233871139"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">Normalement, si votre application est publiée sur le Play Store ou sur l&apos;App Store, vous ne voulez pas qu&apos;elle expire. Si vous voulez le mettre à jour, ajouter des livres ou des fonctionnalités, vous pouvez juste publier la mise à jour et les utilisateurs seront en mesure d&apos;obtenir la nouvelle version. Cependant, si vous créez une version de test à distribuer de manière informelle, vous voudrez probablement définir une date d&apos;expiration.</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="Standard" loext:marker-style-name="T39"><text:span text:style-name="T39">There are three options on the Expiry tab for setting the app duration:</text:span><text:span text:style-name="T39"/></text:p>
   <text:p text:style-name="P9" loext:marker-style-name="T39"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">L&apos;application n&apos;expire pas</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/>C&apos;est la valeur par défaut et appropriée pour les applications publiées.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">L&apos;application expire à une date spécifique</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Vous pouvez spécifier une date à laquelle toutes les copies de l&apos;application expireront sur tous les téléphones. Ce serait approprié pour une version de test que vous voulez être en circulation pendant une période limitée avant de recevoir des commentaires.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">L&apos;application expire un certain nombre de jours après son installation</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Vous pouvez spécifier un nombre de jours (jusqu&apos;à 1000) pour que l&apos;utilisateur puisse accéder à l&apos;application avant qu&apos;elle n&apos;expire. Encore une fois, cela peut être utile pour une période de test.</text:p>
   <text:p text:style-name="P17"/>
   <text:p text:style-name="Standard">Vous pouvez également afficher un message facultatif lorsque l&apos;application expire. Il y a deux options à cet égard:</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Afficher le message et quitter l&apos;application</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Cela serait approprié pour mettre fin à une période d&apos;essai et dire aux gens de regarder la version de sortie de l&apos;application, ou peut-être de contacter une certaine personne afin de donner des commentaires. Après avoir affiché le message, l&apos;application quitte et ne peut plus être exécutée.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Afficher le message mais permettre à l&apos;utilisateur de continuer à utiliser l&apos;application</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Ce serait approprié, par exemple, si la version de test est exacte (vérification par le consultant a été terminée sur les livres) et que l&apos;application a été distribuée du téléphone au téléphone. surtout s&apos;il est difficile pour l&apos;utilisateur d&apos;obtenir une version mise à jour sur Internet.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Vous pouvez taper le message désiré dans la zone de saisie de texte en bas de l&apos;écran.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871140"/>The <text:span text:style-name="T88">Security</text:span> tab<text:bookmark-end text:name="_Toc233871140"/></text:h>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:soft-page-break/><text:span text:style-name="T51">Compression et Chiffrement</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Par défaut, SAB crypte et compresse les données dans l&apos;application. Normalement, vous devriez laisser ce paramètre activé.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Vous pouvez également choisir d&apos;empêcher les utilisateurs de prendre des captures d&apos;écran dans l&apos;application. Une raison possible de l&apos;activer est si vous avez des œuvres protégées par des droits d&apos;auteur dans l&apos;application, et l&apos;artiste ne veut pas que les personnes puissent copier leurs photos sans avis de copyright associé.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Utilisateurs Restreints</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Vous pouvez choisir de laisser n&apos;importe qui installer l&apos;application ou restreindre l&apos;installation de la manière suivante :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Autoriser uniquement les appareils sélectionnés à utiliser cette application</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">C&apos;est le réglage le plus restrictif et peut être applicable dans certains contextes de haute sécurité où seul un ensemble très spécifique de personnes devrait pouvoir installer l&apos;application, en fonction de leur numéro de téléphone ou de leur numéro de série exact. Cliquez sur <text:span text:style-name="T51">Spécifiez les appareils…</text:span> et ajoutez une entrée pour chaque téléphone que vous voulez autoriser.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Require a device-specific access code to use this app</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Avec cette option, vous pouvez créer une série de codes d&apos;accès à envoyer aux utilisateurs afin qu&apos;ils puissent accéder à l&apos;application. Pour cela, un ou plusieurs comptes administrateur doivent être configurés pour envoyer des codes aux utilisateurs. Cette méthode permet une portée plus large que la simple configuration des appareils sélectionnés pour installer l&apos;application.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table35" table:style-name="Table35">
    <table:table-column table:style-name="Table35.A"/>
    <table:table-column table:style-name="Table35.B"/>
    <table:table-row table:style-name="Table35.1">
     <table:table-cell table:style-name="Table35.A1" office:value-type="string">
      <text:p text:style-name="P271" loext:marker-style-name="T42"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T70"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table35.B1" office:value-type="string">
      <text:p text:style-name="P34" loext:marker-style-name="T89">Le code d&apos;accès dépendra de deux choses : l&apos;id de l&apos;appareil et la clé secrète de l&apos;application (définie dans les paramètres de Code d&apos;accès). Si la clé secrète est définie comme la même pour deux applications, alors le même code d&apos;accès ouvrira les deux applications sur un appareil donné. Pour éviter cela, assurez-vous que la clé secrète est complètement différente entre les applications. Une clé légèrement différente (c&apos;est-à-dire un ou deux caractères différents) peut générer le même code d&apos;accès.<text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Require each user to register with their details when they first use the app</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Cette option est utile pour mettre en place une campagne visant à inscrire les utilisateurs et à les tenir informés des mises à jour et de la publicité des choses telles que les groupes d&apos;écoute pour améliorer l&apos;Engagement des Écritures dans une communauté.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:soft-page-break/><text:span text:style-name="T51">Afficher une calculatrice au démarrage. La saisie d&apos;un code donnera accès au contenu de l&apos;application</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Cette option est utile pour les situations de haute sécurité où l&apos;application doit être complètement cachée sur un téléphone. Un numéro numérique spécifique et long peut être spécifié (par exemple 84567.294) en tant que code à mettre dans le champ numéro de la calculatrice. Puis appuyez sur = pour transformer et ouvrir l&apos;application.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table36" table:style-name="Table36">
    <table:table-column table:style-name="Table36.A"/>
    <table:table-column table:style-name="Table36.B"/>
    <table:table-row table:style-name="Table36.1">
     <table:table-cell table:style-name="Table36.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table36.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">Il est conseillé de faire correspondre le nom et l&apos;icône de l&apos;application à ceux d&apos;une application de calculatrice.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P44" text:outline-level="1"><text:bookmark-start text:name="_Toc233871141"/>The <text:span text:style-name="T88">Appearance</text:span> project menu<text:bookmark-end text:name="_Toc233871141"/></text:h>
   <text:h text:style-name="P65" text:outline-level="2"><text:bookmark text:name="_Icons"/><text:bookmark-start text:name="_Toc233871142"/>Icônes<text:bookmark-end text:name="_Toc233871142"/></text:h>
   <text:p text:style-name="Standard">Les icônes sont des éléments graphiques importants de votre application. En quelque sorte, ils représentent votre application à l&apos;utilisateur. Bien que SAB fournisse une galerie d&apos;images d&apos;icônes, il est recommandé de prier, pensée créative pour créer une icône d&apos;application unique, peut-être en suivant un design de marque plus large pour toutes vos applications.</text:p>
   <text:p text:style-name="Standard">L&apos;élément de menu <text:span text:style-name="T51">Icônes</text:span> couvre à la fois l&apos;icône que l&apos;utilisateur voit sur son écran de téléphone qui lance l&apos;application, et l&apos;icône de notification associée à votre application qui apparaît à côté de tous les messages texte de notification qui s&apos;affichent. Le menu <text:span text:style-name="T51">Icônes</text:span> a quatre onglets :</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871143"/>The <text:span text:style-name="T88">Android Icon</text:span> tab<text:bookmark-end text:name="_Toc233871143"/></text:h>
   <text:p text:style-name="Standard">Les appareils de la version 8.0 d&apos;Android à Android 11 prennent en charge les icônes adaptatives. Il est important de définir une icône adaptative pour votre application, sinon l&apos;icône ne sera pas bien affichée sur ces téléphones. L&apos;onglet Icône Android donne un exemple de l&apos;apparence de votre icône avec chacun des choix d&apos;icônes adaptatives. Il montre aussi comment il va regarder à plusieurs tailles.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Utilisez <text:span text:style-name="T51">Créer une nouvelle icône… </text:span>pour créer une icône pour votre application. Cela produira à la fois une icône adaptative pour les nouvelles versions d&apos;Android, et toutes les tailles nécessaires pour les anciennes versions. Cet assistant a deux écrans :</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard" loext:marker-style-name="T51"><text:span text:style-name="T51">Image de premier plan</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard">Sélectionnez l&apos;image de premier plan de votre icône et réglez le pourcentage de rembourrage.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P10" loext:marker-style-name="T51"><text:span text:style-name="T51">Image d&apos;arrière-plan</text:span><text:span text:style-name="T51"/></text:p>
   <text:p text:style-name="Standard"><text:soft-page-break/>Sélectionnez une couleur pour l&apos;arrière-plan de l&apos;icône ou une image avec un fond non transparent. Android utilisera l&apos;image d&apos;arrière-plan pour remplir la bordure extérieure des différentes formes d&apos;icônes adaptatives.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871144"/>The <text:span text:style-name="T88">Android Icon Layers</text:span> tab<text:bookmark-end text:name="_Toc233871144"/></text:h>
   <text:p text:style-name="Standard">Les couches de premier plan et de fond pour les icônes adaptatives sont spécifiées séparément. Les utilisateurs peuvent décider quelle forme ils veulent leurs icônes, et le système Android utilisera la couche de fond pour remplir cette forme, puis placera le calque de premier plan sur le haut.</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="P3" loext:marker-style-name="T167"><draw:frame draw:style-name="fr4" draw:name="Picture 28" text:anchor-type="as-char" svg:width="1.8902in" svg:height="3.5083in" draw:z-index="0"><draw:image xlink:href="SAB02/18.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Vous pouvez également ajuster l&apos;image du calque de premier plan en utilisant le curseur de pourcentage. Visez à avoir l&apos;image un peu plus grande que la zone encerclée. Vous pouvez également modifier l&apos;image d&apos;arrière-plan que vous avez sélectionnée dans l&apos;assistant <text:span text:style-name="T51">Créer une nouvelle icône</text:span>. Utilisez la zone de liste de prévisualisation pour afficher les différentes images d&apos;icônes adaptatives créées par Android.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871145"/>The <text:span text:style-name="T88">Android Legacy Icons</text:span> tab<text:bookmark-end text:name="_Toc233871145"/></text:h>
   <text:p text:style-name="Standard">Anciennes icônes (celles pour les versions d&apos;Android antérieures à 8. ) doivent être spécifiées dans une variété de tailles, et le système d&apos;exploitation du téléphone sélectionnera la taille d&apos;icône qui est la plus à afficher. Utilisez le bouton <text:span text:style-name="T51">Générer à partir de l&apos;icône Adaptive</text:span> pour créer automatiquement ces tailles à partir de l&apos;icône spécifiée dans l&apos;assistant <text:span text:style-name="T51">Créer une nouvelle icône</text:span>. Vous pouvez également utiliser un outil comme <text:a xlink:type="simple" xlink:href="https://icon.kitchen/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">IconKitchen</text:span></text:a>. IconKitchen va créer un fichier .zip que vous pouvez télécharger avec toutes les tailles. Utilisez <text:span text:style-name="T51">Ajouter des images d&apos;icônes…</text:span> pour sélectionner le zip téléchargé et SAB ouvrira le fichier et assignera toutes les tailles.</text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table37" table:style-name="Table37">
    <table:table-column table:style-name="Table37.A"/>
    <table:table-column table:style-name="Table37.B"/>
    <table:table-row table:style-name="Table37.1">
     <table:table-cell table:style-name="Table37.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T68">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table37.B1" office:value-type="string">
      <text:p text:style-name="P11" loext:marker-style-name="T88"><text:span text:style-name="T88">Alors que IconKitchen a quelques outils de base pour concevoir une icône à partir de zéro, vous pouvez préférer utiliser un générateur d&apos;images IA comme CoPilot pour créer une image d&apos;icône de base que vous pouvez ensuite sélectionner dans IconKitchen, ajuster et télécharger.</text:span><text:span text:style-name="T88"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">SAB créera une série de dossiers sous le sous-dossier <text:span text:style-name="T51">Images</text:span> du dossier de données du projet, un pour chaque taille d&apos;icône. (Voir <text:a xlink:type="simple" xlink:href="#_Project-specific_data_folders" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Dossiers de données spécifiques au projet</text:span></text:a>). Vous pouvez voir ces noms de dossiers sous la colonne <text:span text:style-name="T51">Nom de fichier</text:span> de la liste d&apos;affichage de l&apos;icône Legacy. Chaque nom d&apos;icône est identique : <text:span text:style-name="T51">ic_launcher.png</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table38" table:style-name="Table38">
    <table:table-column table:style-name="Table38.A"/>
    <table:table-column table:style-name="Table38.B"/>
    <table:table-row table:style-name="Table38.1">
     <table:table-cell table:style-name="Table38.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table38.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">If you want to publish your app on the Google Play store, you will need the 512 x 512 icon image stored in the </text:span><text:span text:style-name="T94">drawable-web</text:span><text:span text:style-name="T89"> subfolder. Vous pouvez également utiliser cette image dans le cadre de la fonctionnalité graphique requise.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P73" text:outline-level="3"><text:bookmark-start text:name="_Toc233871146"/>The <text:span text:style-name="T88">Notification Icon</text:span> tab<text:bookmark-end text:name="_Toc233871146"/></text:h>
   <text:p text:style-name="Standard"><text:soft-page-break/>Cet onglet est identique à l&apos;onglet <text:a xlink:type="simple" xlink:href="#_The_Notification_Icon" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="Internet_20_link">Icône de Notification</text:span></text:a> sous <text:span text:style-name="T51">Engagement </text:span><text:span text:style-name="T72">&lt;unk&gt;</text:span><text:span text:style-name="T51"> Notifications</text:span>.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P55" text:outline-level="2"><text:bookmark text:name="_Graphics"/><text:bookmark-start text:name="_Toc233871147"/>Graphiques<text:bookmark-end text:name="_Toc233871147"/></text:h>
   <text:p text:style-name="Standard">Ce menu vous permet de définir plusieurs éléments graphiques optionnels pour votre application. Cliquez sur un onglet pour modifier cet élément.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871148"/>The <text:span text:style-name="T88">Android Splash Screen</text:span> tab<text:bookmark-end text:name="_Toc233871148"/></text:h>
   <text:p text:style-name="Standard">Un écran de démarrage est un écran de titre pour votre application qui peut s&apos;afficher automatiquement pour un nombre spécifié de millisecondes lorsque votre application est lancée. Un écran de démarrage peut être une « intro» attrayante pour votre application et devrait être configuré pour afficher suffisamment longtemps pour que l&apos;utilisateur puisse lire n&apos;importe quel texte sur elle, mais pas si longtemps qu&apos;il devient ennuyeux. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Il y a trois tailles recommandées pour les écrans de démarrage Android. Il est probable que le système du téléphone choisira celui qui convient le mieux à la résolution et au rapport d’aspect du téléphone. Si on ne tient pas exactement, nous supposons que l’OS va redimensionner la taille la plus proche pour s’adapter. Dans ce cas, pour de meilleurs résultats, vous devriez au moins fournir la plus grande taille (720x1280).</text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame7" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0555in" svg:width="5.9374in" draw:z-index="30" loext:may-break-between-pages="true">
     <draw:text-box fo:min-height="0.0161in">
      <table:table table:name="Table39" table:style-name="Table39">
       <table:table-column table:style-name="Table39.A"/>
       <table:table-column table:style-name="Table39.B"/>
       <table:table-row table:style-name="Table39.1">
        <table:table-cell table:style-name="Table39.A1" office:value-type="string">
         <text:p text:style-name="P269" loext:marker-style-name="T3"><text:span text:style-name="T68">&lt;unk&gt;</text:span><text:span text:style-name="T3"> </text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table39.B1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T88"><text:span text:style-name="T88">Si le texte de l&apos;Écriture a déjà été publié comme un livre physique, vous pouvez utiliser la couverture de ce livre comme écran de démarrage pour afficher la continuité avec le texte imprimé. Vous pouvez également utiliser un design incorporant l&apos;icône de votre application avec le nom de l&apos;application. Essayez d&apos;harmoniser les couleurs de l&apos;écran de démarrage avec les couleurs de l&apos;icône et de l&apos;interface.</text:span></text:p>
        </table:table-cell>
       </table:table-row>
      </table:table>
     </draw:text-box>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard">Cochez la case sur <text:span text:style-name="T51">Afficher l&apos;écran de démarrage au démarrage, </text:span>et définissez le nombre de millisecondes. Environ 800 - 1000 millisecondes est un intervalle raisonnable, suggéré.</text:p>
   <text:p text:style-name="Standard"/>
   <text:h text:style-name="P72" text:outline-level="3"><text:bookmark-start text:name="_Toc233871149"/>The <text:span text:style-name="T88">Navigation Drawer</text:span> tab<text:bookmark-end text:name="_Toc233871149"/></text:h>
   <text:p text:style-name="Standard">L&apos;image optionnelle du panneau de navigation apparaît en haut du panneau de navigation de l&apos;application. Par défaut, c&apos;est une image simple et ouverte. L&apos;ajout de votre propre image rend l&apos;application plus esthétiquement agréable, surtout si vous utilisez des éléments de l&apos;icône, les couleurs de l&apos;interface et / ou de l&apos;écran de démarrage dans le design. <text:span text:style-name="T19">Il peut s&apos;agir d&apos;une photo, du logo de votre organisation ou de tout autre design graphique pertinent.</text:span></text:p>
   <text:p text:style-name="Standard"/>
   <table:table table:name="Table40" table:style-name="Table40">
    <table:table-column table:style-name="Table40.A"/>
    <table:table-column table:style-name="Table40.B"/>
    <table:table-row table:style-name="Table40.1">
     <table:table-cell table:style-name="Table40.A1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T63"><text:span text:style-name="T64">&lt;unk&gt;</text:span><text:span text:style-name="T65"/></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table40.B1" office:value-type="string">
      <text:p text:style-name="P269" loext:marker-style-name="T89"><text:span text:style-name="T89">La partie supérieure de l&apos;image du tiroir de navigation sera partiellement masquée par la zone ombragée. Assurez-vous que votre image affiche clairement ce que vous voulez que l&apos;utilisateur puisse voir.</text:span><text:span text:style-name="T89"/></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard">Comme pour l&apos;écran de démarrage, SAB donne un certain nombre de tailles suggérées, le tout en utilisant un ratio 16:9. Si vous voulez inclure votre propre image de tiroir de navigation, vous devez au moins fournir la taille la plus grande pour qu&apos;il soit bien à l&apos;échelle.</text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr9" draw:name="Picture 29" text:anchor-type="char" svg:x="3.3583in" svg:y="0.1799in" svg:width="1.8799in" svg:height="4.0016in" draw:z-index="23"><draw:image xlink:href="SAB02/20.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:soft-page-break/><text:s/><draw:frame draw:style-name="fr9" draw:name="Picture 26" text:anchor-type="char" svg:x="0.5772in" svg:y="0.1902in" svg:width="1.8744in" svg:height="3.9898in" draw:z-index="289"><draw:image xlink:href="SAB02/19.png" xlink:type="simple" xlink:show="embed" xlink:actuate="onLoad" draw:mime-type="image/png"/>
    </draw:frame><text:s/></text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:custom-shape text:anchor-type="char" draw:z-index="278" draw:name="AutoShape 160" draw:style-name="gr5" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (2.52217530205701) translate (5.46666666666667in 0.619444444444445in)">
     <text:p/>
     <draw:enhanced-geometry draw:mirror-horizontal="false" draw:mirror-vertical="false" svg:viewBox="0 0 0 0" draw:glue-points="?f5 0 0 ?f7 ?f5 ?f13 ?f14 ?f7" draw:text-areas="0 ?f8 ?f12 ?f9" draw:type="ooxml-rightArrow" draw:modifiers="50000 49253" draw:enhanced-path="M 0 ?f8 L ?f5 ?f8 ?f5 0 ?f14 ?f7 ?f5 ?f13 ?f5 ?f9 0 ?f9 Z N">
      <draw:equation draw:name="f0" draw:formula="min(logwidth,logheight)"/>
      <draw:equation draw:name="f1" draw:formula="100000*logwidth/?f0 "/>
      <draw:equation draw:name="f2" draw:formula="if(0-$0 ,0,if(100000-$0 ,$0 ,100000))"/>
      <draw:equation draw:name="f3" draw:formula="if(0-$1 ,0,if(?f1 -$1 ,$1 ,?f1 ))"/>
      <draw:equation draw:name="f4" draw:formula="?f0 *?f3 /100000"/>
      <draw:equation draw:name="f5" draw:formula="logwidth+0-?f4 "/>
      <draw:equation draw:name="f6" draw:formula="logheight*?f2 /200000"/>
      <draw:equation draw:name="f7" draw:formula="logheight/2"/>
      <draw:equation draw:name="f8" draw:formula="?f7 +0-?f6 "/>
      <draw:equation draw:name="f9" draw:formula="?f7 +?f6 -0"/>
      <draw:equation draw:name="f10" draw:formula="logheight/2"/>
      <draw:equation draw:name="f11" draw:formula="?f8 *?f4 /?f10 "/>
      <draw:equation draw:name="f12" draw:formula="?f5 +?f11 -0"/>
      <draw:equation draw:name="f13" draw:formula="logheight"/>
      <draw:equation draw:name="f14" draw:formula="logwidth"/>
      <draw:handle draw:handle-range-y-minimum="0" draw:handle-position="0 ?f8" draw:handle-range-y-maximum="100000"/>
      <draw:handle draw:handle-range-x-minimum="0" draw:handle-position="?f5 0" draw:handle-range-x-maximum="?f1"/>
     </draw:enhanced-geometry>
    </draw:custom-shape><text:s/></text:p>
   <text:p text:style-name="Standard"><draw:custom-shape text:anchor-type="char" draw:z-index="23" draw:name="AutoShape 160" draw:style-name="gr14" draw:text-style-name="P521" svg:width="0.5953in" svg:height="0.3024in" draw:transform="rotate (0.678409480250196) translate (0.138194444444444in 0.286805555555556in)">
     <text:p/>
