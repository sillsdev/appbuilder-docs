   <text:h text:style-name="P71" text:outline-level="2"><text:bookmark-start text:name="_Toc233871389"/>Highlighter Pen Styles<text:bookmark-end text:name="_Toc233871389"/></text:h>
   <text:p text:style-name="Standard"><text:soft-page-break/>These are used for the five highlighter pen color choices displayed when a verse is selected and <text:span text:style-name="T51">Engagement </text:span><text:span text:style-name="T72"></text:span><text:span text:style-name="T51"> Annotations </text:span><text:span text:style-name="T72"></text:span><text:span text:style-name="T51"> Highlighting</text:span> is turned on in the app. </text:p>
   <text:p text:style-name="Standard"/>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr2" draw:name="Frame42" text:anchor-type="paragraph" svg:x="-0.0035in" svg:y="0.0992in" svg:width="5.978in" draw:z-index="313" loext:may-break-between-pages="true">
