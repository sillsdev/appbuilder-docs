       <table:table-row table:style-name="Table125.1">
        <table:table-cell table:style-name="Table125.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">To modify this…</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table125.A1" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T52"><text:span text:style-name="T52">Adjust this style…</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table125.1">
        <table:table-cell table:style-name="Table125.A2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">The general placement of the study notes block including padding margins.</text:span></text:p>
        </table:table-cell>
        <table:table-cell table:style-name="Table125.B2" office:value-type="string">
         <text:p text:style-name="P11" loext:marker-style-name="T39"><text:span text:style-name="T39">.study-bible-block</text:span></text:p>
        </table:table-cell>
       </table:table-row>
       <table:table-row table:style-name="Table125.1">
